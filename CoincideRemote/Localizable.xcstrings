        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ के नए थ्रेड पर लागू होता है। मौजूदा थ्रेड अपनी सेटिंग्ज़ बनाए रखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berlaku untuk utas baru di %@. Utas yang ada tetap memakai pengaturannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si applica ai nuovi thread in %@. I thread esistenti mantengono le loro impostazioni."
