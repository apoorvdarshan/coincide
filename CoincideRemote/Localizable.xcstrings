    "Existing threads are kept. A running thread continues until you stop it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vorhandene Threads bleiben erhalten. Ein laufender Thread wird fortgesetzt, bis du ihn stoppst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conservan los hilos existentes. Un hilo en ejecución continúa hasta que lo detengas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conservan los hilos existentes. Un hilo en ejecución continúa hasta que lo detengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fils existants sont conservés. Un fil en cours continue jusqu’à ce que vous l’arrêtiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मौजूदा थ्रेड रखे जाते हैं। चल रहा थ्रेड आपके रोकने तक चलता रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utas yang ada tetap disimpan. Utas yang berjalan berlanjut sampai Anda menghentikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le conversazioni esistenti vengono mantenute. Una conversazione in corso continua finché non la interrompi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "既存のスレッドは保持されます。実行中のスレッドは停止するまで続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "기존 스레드는 유지됩니다. 실행 중인 스레드는 직접 중지할 때까지 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bestaande gesprekken blijven bewaard. Een lopend gesprek gaat door totdat je het stopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Istniejące wątki zostają zachowane. Działający wątek będzie kontynuowany, dopóki go nie zatrzymasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As conversas existentes são mantidas. Uma conversa em execução continua até você pará-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Существующие диалоги сохраняются. Работающий диалог продолжится, пока вы его не остановите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
