    "Alerts stay on your Mac. Turn notifications on in Settings to get them here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hinweise bleiben auf deinem Mac. Aktiviere Mitteilungen in den Einstellungen, um sie hier zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las alertas se quedan en tu Mac. Activa las notificaciones en Ajustes para recibirlas aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las alertas se quedan en tu Mac. Activa las notificaciones en Configuración para recibirlas aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les alertes restent sur votre Mac. Activez les notifications dans Réglages pour les recevoir ici."
