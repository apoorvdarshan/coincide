          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alerty zostają na Macu. Włącz powiadomienia w Ustawieniach, aby otrzymywać je tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
