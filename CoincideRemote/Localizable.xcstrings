    "Allow Local Network access for Coincide Remote in Settings › Privacy & Security › Local Network to find Macs nearby." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube Coincide Remote unter „Einstellungen“ › „Datenschutz & Sicherheit“ › „Lokales Netzwerk“ den Zugriff, um Macs in der Nähe zu finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a la red local para Coincide Remote en Ajustes › Privacidad y seguridad › Red local para encontrar Macs cercanos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a la red local para Coincide Remote en Configuración › Privacidad y seguridad › Red local para encontrar Macs cercanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez l'accès au réseau local pour Coincide Remote dans Réglages › Confidentialité et sécurité › Réseau local pour trouver les Mac à proximité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आस-पास के Mac ढूँढने के लिए सेटिंग्ज़ › गोपनीयता और सुरक्षा › स्थानीय नेटवर्क में Coincide Remote को स्थानीय नेटवर्क ऐक्सेस की अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izinkan akses Jaringan Lokal untuk Coincide Remote di Pengaturan › Privasi & Keamanan › Jaringan Lokal untuk menemukan Mac di sekitar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consenti l'accesso alla rete locale per Coincide Remote in Impostazioni › Privacy e sicurezza › Rete locale per trovare i Mac nelle vicinanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "近くのMacを見つけるには、設定 › プライバシーとセキュリティ › ローカルネットワークでCoincide Remoteのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주변의 Mac을 찾으려면 설정 › 개인정보 보호 및 보안 › 로컬 네트워크에서 Coincide Remote의 로컬 네트워크 접근을 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sta toegang tot het lokale netwerk toe voor Coincide Remote in Instellingen › Privacy en beveiliging › Lokaal netwerk om Macs in de buurt te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zezwól Coincide Remote na dostęp do sieci lokalnej w Ustawienia › Prywatność i ochrona › Sieć lokalna, aby znajdować Maki w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita o acesso à Rede Local para o Coincide Remote em Ajustes › Privacidade e Segurança › Rede Local para encontrar Macs por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чтобы находить компьютеры Mac поблизости, разрешите Coincide Remote доступ к локальной сети в разделе «Настройки» › «Конфиденциальность и безопасность» › «Локальная сеть»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yakındaki Mac'leri bulmak için Ayarlar › Gizlilik ve Güvenlik › Yerel Ağ bölümünde Coincide Remote'un yerel ağ erişimine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоб знаходити комп’ютери Mac поблизу, дозвольте Coincide Remote доступ до локальної мережі в розділі «Параметри» › «Приватність і безпека» › «Локальна мережа»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hãy cho phép Coincide Remote truy cập Mạng cục bộ trong Cài đặt › Quyền riêng tư & Bảo mật › Mạng cục bộ để tìm các máy Mac ở gần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请在“设置” › “隐私与安全性” › “本地网络”中允许 Coincide Remote 访问本地网络，以查找附近的 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "請在「設定」›「隱私權與安全性」›「區域網路」中允許 Coincide Remote 取用區域網路，以尋找附近的 Mac。"
          }
        }
      }
    },
    "Allow camera access in Settings, or copy the code on the Mac and use Paste Pairing Code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube den Kamerazugriff in den Einstellungen oder kopiere den Code auf dem Mac und verwende „Kopplungscode einsetzen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a la cámara en Ajustes, o copia el código en el Mac y usa “Pegar código de enlace”."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a la cámara en Configuración, o copia el código en la Mac y usa “Pegar código de enlace”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez l'accès à l'appareil photo dans Réglages, ou copiez le code sur le Mac et utilisez « Coller le code de jumelage »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सेटिंग्ज़ में कैमरा ऐक्सेस की अनुमति दें, या Mac पर कोड कॉपी करें और “पेयरिंग कोड पेस्ट करें” इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izinkan akses kamera di Pengaturan, atau salin kode di Mac dan gunakan Tempel Kode Pemasangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consenti l'accesso alla fotocamera in Impostazioni, oppure copia il codice sul Mac e usa “Incolla codice di abbinamento”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "設定でカメラへのアクセスを許可するか、Macでコードをコピーして“ペアリングコードをペースト”を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "설정에서 카메라 접근을 허용하거나, Mac에서 코드를 복사한 후 “페어링 코드 붙여넣기”를 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sta cameratoegang toe in Instellingen, of kopieer de code op de Mac en gebruik “Plak koppelcode”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zezwól na dostęp do aparatu w Ustawieniach albo skopiuj kod na Macu i użyj opcji „Wklej kod parowania”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita o acesso à câmera nos Ajustes ou copie o código no Mac e use “Colar Código de Emparelhamento”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разрешите доступ к камере в Настройках или скопируйте код на Mac и нажмите «Вставить код привязки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ayarlar'da kamera erişimine izin verin veya kodu Mac'te kopyalayıp Eşleştirme Kodunu Yapıştır'ı kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дозвольте доступ до камери в Параметрах або скопіюйте код на Mac і торкніться «Вставити код прив’язки»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hãy cho phép truy cập camera trong Cài đặt, hoặc sao chép mã trên máy Mac và dùng “Dán mã ghép đôi”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请在“设置”中允许访问相机，或在 Mac 上拷贝配对码，然后使用“粘贴配对码”。"
          }
        },
        "zh-Hant" : {
