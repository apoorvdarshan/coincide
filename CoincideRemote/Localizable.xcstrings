    "Allow Local Network access for Coincide Remote in Settings › Privacy & Security › Local Network to find Macs nearby." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube Coincide Remote unter „Einstellungen“ › „Datenschutz & Sicherheit“ › „Lokales Netzwerk“ den Zugriff, um Macs in der Nähe zu finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a la red local para Coincide Remote en Ajustes › Privacidad y seguridad › Red local para encontrar Macs cercanos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite el acceso a la red local para Coincide Remote en Configuración › Privacidad y seguridad › Red local para encontrar Macs cercanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez l'accès au réseau local pour Coincide Remote dans Réglages › Confidentialité et sécurité › Réseau local pour trouver les Mac à proximité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आस-पास के Mac ढूँढने के लिए सेटिंग्ज़ › गोपनीयता और सुरक्षा › स्थानीय नेटवर्क में Coincide Remote को स्थानीय नेटवर्क ऐक्सेस की अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izinkan akses Jaringan Lokal untuk Coincide Remote di Pengaturan › Privasi & Keamanan › Jaringan Lokal untuk menemukan Mac di sekitar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consenti l'accesso alla rete locale per Coincide Remote in Impostazioni › Privacy e sicurezza › Rete locale per trovare i Mac nelle vicinanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "近くのMacを見つけるには、設定 › プライバシーとセキュリティ › ローカルネットワークでCoincide Remoteのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "주변의 Mac을 찾으려면 설정 › 개인정보 보호 및 보안 › 로컬 네트워크에서 Coincide Remote의 로컬 네트워크 접근을 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sta toegang tot het lokale netwerk toe voor Coincide Remote in Instellingen › Privacy en beveiliging › Lokaal netwerk om Macs in de buurt te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zezwól Coincide Remote na dostęp do sieci lokalnej w Ustawienia › Prywatność i ochrona › Sieć lokalna, aby znajdować Maki w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita o acesso à Rede Local para o Coincide Remote em Ajustes › Privacidade e Segurança › Rede Local para encontrar Macs por perto."
