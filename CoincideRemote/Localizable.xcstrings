    "When you’re at your Mac, Coincide notifies there instead of your iPad, so nothing shows twice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du an deinem Mac bist, benachrichtigt Coincide dort statt auf deinem iPad, damit nichts doppelt erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando estás en tu Mac, Coincide te avisa allí en lugar de en tu iPad, para que nada aparezca dos veces."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando estás en tu Mac, Coincide te avisa ahí en lugar de en tu iPad, para que nada aparezca dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lorsque vous êtes devant votre Mac, Coincide vous avertit sur celui-ci plutôt que sur votre iPad, pour que rien n’apparaisse deux fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब आप अपने Mac पर हों, तो Coincide आपके iPad के बजाय वहीं सूचना देता है, ताकि कुछ भी दो बार न दिखे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saat Anda berada di Mac, Coincide memberi tahu di sana, bukan di iPad Anda, agar tidak ada yang muncul dua kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando sei al Mac, Coincide ti avvisa lì invece che sull’iPad, così niente appare due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Macを使っているときは、iPadではなくMacで通知するので、同じ通知が2回表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac을 사용하는 동안에는 iPad 대신 Mac에서 알리므로 같은 알림이 두 번 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je achter je Mac zit, meldt Coincide het daar in plaats van op je iPad, zodat niets twee keer verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdy jesteś przy Macu, Coincide powiadamia tam zamiast na iPadzie, więc nic nie pojawia się dwa razy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando você está no Mac, o Coincide avisa lá em vez de no iPad, para nada aparecer duas vezes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Когда вы за Mac, Coincide уведомляет там, а не на iPad, чтобы ничего не показывалось дважды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac’inizin başındayken Coincide iPad’iniz yerine orada bildirir; böylece hiçbir şey iki kez görünmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Коли ви за Mac, Coincide сповіщає там, а не на iPad, щоб нічого не показувалося двічі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Khi bạn đang ở máy Mac, Coincide sẽ thông báo ở đó thay vì trên iPad để không có gì hiện hai lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当你在使用 Mac 时，Coincide 会在 Mac 上通知你，而不是在 iPad 上，这样就不会重复显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "當你在使用 Mac 時，Coincide 會在 Mac 上通知你，而不是在 iPad 上，這樣就不會重複顯示。"
          }
        }
      }
    },
