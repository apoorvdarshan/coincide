    "On your Mac, open Coincide’s Settings › General › Remote, turn on Allow Coincide Remote, and click Pair iPhone or iPad." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffne auf deinem Mac die Einstellungen von Coincide › Allgemein › Fernzugriff, aktiviere „Coincide Remote erlauben“ und klicke auf „iPhone oder iPad koppeln“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En tu Mac, abre los Ajustes de Coincide › General › Acceso remoto, activa “Permitir Coincide Remote” y haz clic en “Enlazar iPhone o iPad…”."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En tu Mac, abre la Configuración de Coincide › General › Acceso remoto, activa “Permitir Coincide Remote” y haz clic en “Enlazar iPhone o iPad…”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sur votre Mac, ouvrez les réglages de Coincide › Général › Accès à distance, activez « Autoriser Coincide Remote » et cliquez sur « Jumeler un iPhone ou un iPad »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने Mac पर Coincide की सेटिंग्ज़ › सामान्य › रिमोट एक्सेस खोलें, “Coincide Remote की अनुमति दें” चालू करें, और “iPhone या iPad पेयर करें” पर क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di Mac Anda, buka Pengaturan Coincide › Umum › Akses Jarak Jauh, nyalakan Izinkan Coincide Remote, lalu klik Pasangkan iPhone atau iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sul Mac, apri Impostazioni › Generali › Accesso remoto in Coincide, attiva “Consenti Coincide Remote” e fai clic su “Abbina iPhone o iPad”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "MacでCoincideの設定 › 一般 › リモートアクセスを開き、“Coincide Remoteを許可”をオンにして、“iPhoneまたはiPadをペアリング”をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac에서 Coincide의 설정 › 일반 › 원격 접근을 열고 “Coincide Remote 허용”을 켠 다음 “iPhone 또는 iPad 페어링”을 클릭하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Open op je Mac in Coincide Instellingen › Algemeen › Externe toegang, schakel “Sta Coincide Remote toe” in en klik op “Koppel iPhone of iPad”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na Macu otwórz w Coincide Ustawienia › Ogólne › Dostęp zdalny, włącz „Zezwalaj na Coincide Remote” i kliknij „Sparuj iPhone’a lub iPada”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No seu Mac, abra os Ajustes do Coincide › Geral › Acesso remoto, ative “Permitir o Coincide Remote” e clique em “Emparelhar iPhone ou iPad…”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На Mac откройте в Coincide «Настройки» › «Основные» › «Удалённый доступ», включите «Разрешить Coincide Remote» и нажмите «Привязать iPhone или iPad»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mac'inizde Coincide'ın Ayarlar › Genel › Uzaktan Erişim bölümünü açın, Coincide Remote'a İzin Ver'i açın ve iPhone veya iPad Eşleştir'e tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На Mac відкрийте в Coincide «Параметри» › «Загальні» › «Віддалений доступ», увімкніть «Дозволити Coincide Remote» і натисніть «Прив’язати iPhone або iPad»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trên máy Mac, mở Cài đặt › Chung › Truy cập từ xa của Coincide, bật “Cho phép Coincide Remote” rồi bấm “Ghép đôi iPhone hoặc iPad”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 Mac 上打开 Coincide 的“设置” › “通用” › “远程访问”，打开“允许 Coincide Remote”，然后点按“配对 iPhone 或 iPad”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 Mac 上打開 Coincide 的「設定」›「一般」›「遠端存取」，開啟「允許 Coincide Remote」，然後按一下「配對 iPhone 或 iPad」。"
          }
        }
      }
    },
