          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide를 종료할 때까지 Mac에서 삭제를 실행 취소할 수 있습니다. 프로젝트의 파일은 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
