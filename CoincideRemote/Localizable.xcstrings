    "You can undo the deletion on the Mac until Coincide quits. Files in the project aren’t changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst das Löschen auf dem Mac widerrufen, bis Coincide beendet wird. Dateien im Projekt werden nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes deshacer la eliminación en el Mac hasta que salgas de Coincide. Los archivos del proyecto no se modifican."
          }
        },
        "es-419" : {
          "stringUnit" : {
