        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सेटिंग्ज़ में कैमरा ऐक्सेस की अनुमति दें, या Mac पर कोड कॉपी करें और “पेयरिंग कोड पेस्ट करें” इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izinkan akses kamera di Pengaturan, atau salin kode di Mac dan gunakan Tempel Kode Pemasangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consenti l'accesso alla fotocamera in Impostazioni, oppure copia il codice sul Mac e usa “Incolla codice di abbinamento”."
          }
        },
        "ja" : {
          "stringUnit" : {
