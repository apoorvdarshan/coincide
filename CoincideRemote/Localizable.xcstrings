          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоб знаходити комп’ютери Mac поблизу, дозвольте Coincide Remote доступ до локальної мережі в розділі «Параметри» › «Приватність і безпека» › «Локальна мережа»."
          }
        },
        "vi" : {
          "stringUnit" : {
