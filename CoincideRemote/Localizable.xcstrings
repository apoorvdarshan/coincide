    "The code works once, for a few minutes. Copy Code on the Mac puts it on your clipboard with Universal Clipboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Code gilt einmalig und nur ein paar Minuten. „Code kopieren“ auf dem Mac legt ihn mit der Universellen Zwischenablage in deine Zwischenablage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El código funciona una vez, durante unos minutos. “Copiar código” en el Mac lo pone en tu portapapeles con Portapapeles universal."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El código funciona una vez, durante unos minutos. “Copiar código” en la Mac lo pone en tu portapapeles con Portapapeles universal."
          }
