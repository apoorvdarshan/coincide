    "Add a schedule, or ask the agent to do something later or on a schedule." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge einen Zeitplan hinzu oder bitte den Agenten, etwas später oder nach Zeitplan zu erledigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agrega una programación o pide al agente que haga algo más tarde o de forma programada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agrega una programación o pídele al agente que haga algo más tarde o de forma programada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez une planification, ou demandez à l’agent de faire quelque chose plus tard ou à intervalles réguliers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "समय-सारणी जोड़ें, या एजेंट से कोई काम बाद में या तय समय पर करने को कहें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tambahkan jadwal, atau minta agen melakukan sesuatu nanti atau sesuai jadwal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aggiungi una pianificazione o chiedi all’agente di fare qualcosa più tardi o a intervalli regolari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スケジュールを追加するか、あとで実行することや定期的に実行することをエージェントに頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "일정을 추가하거나, 에이전트에게 나중에 또는 일정에 따라 할 일을 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voeg een schema toe, of vraag de agent iets later of volgens een schema te doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dodaj harmonogram albo poproś agenta, aby zrobił coś później lub według harmonogramu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione um agendamento ou peça ao agente para fazer algo mais tarde ou de forma agendada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Добавьте расписание или попросите агента сделать что-нибудь позже или по расписанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
