          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide बंद होने तक आप Mac पर डिलीट करना पूर्ववत कर सकते हैं। प्रोजेक्ट की फ़ाइलें नहीं बदलतीं।"
