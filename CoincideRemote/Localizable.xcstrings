          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बातचीत इस संदेश से पहले तक वापस ले जाई जाती है, और यह संदेश, संदेश बॉक्स में लौट आता है। डिस्क पर मौजूद फ़ाइलें नहीं बदलतीं।"
