    "The conversation is rewound to before this message, which returns to the composer. Files on disk are not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Gespräch wird auf den Stand vor dieser Nachricht zurückgespult, die wieder im Eingabefeld landet. Dateien auf dem Datenträger werden nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La conversación se retrocede hasta antes de este mensaje, que vuelve al cuadro de mensaje. Los archivos del disco no se modifican."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La conversación retrocede a antes de este mensaje, que vuelve al cuadro de mensaje. Los archivos en el disco no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
