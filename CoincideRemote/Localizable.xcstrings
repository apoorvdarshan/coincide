        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ removeu este dispositivo. Emparelhe-o novamente para se conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ удалил это устройство. Чтобы подключиться, привяжите его снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ bu aygıtı kaldırdı. Bağlanmak için yeniden eşleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ вилучив цей пристрій. Щоб підключитися, прив’яжіть його знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ đã gỡ thiết bị này. Hãy ghép đôi lại để kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已移除此设备。请重新配对以连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已移除此裝置。請重新配對以連線。"
