    "%@ has notifications turned off, so it sends none here either." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat Mitteilungen deaktiviert und sendet daher auch hier keine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ tiene las notificaciones desactivadas, así que tampoco envía ninguna aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ tiene las notificaciones desactivadas, así que tampoco envía ninguna aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les notifications sont désactivées sur %@ : il n'en envoie donc pas ici non plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ पर सूचनाएँ बंद हैं, इसलिए यहाँ भी कोई सूचना नहीं आती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pemberitahuan dimatikan di %@, jadi tidak ada pemberitahuan yang dikirim ke sini juga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha le notifiche disattivate, quindi non ne invia nemmeno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@で通知がオフになっているため、こちらにも通知は届きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에서 알림이 꺼져 있으므로 여기로도 알림을 보내지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ heeft meldingen uitgeschakeld en stuurt er hier dus ook geen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ma wyłączone powiadomienia, więc tutaj też ich nie wysyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está com as notificações desativadas, então também não envia nenhuma para cá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На %@ уведомления выключены, поэтому сюда они тоже не приходят."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ bildirimleri kapattığı için buraya da bildirim göndermiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На %@ сповіщення вимкнено, тож сюди вони теж не надходять."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ đang tắt thông báo, nên cũng không gửi thông báo nào đến đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已关闭通知，因此也不会向这里发送通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 已關閉通知，因此也不會傳送通知到這裡。"
          }
        }
      }
    },
    "%@ isn’t reachable. Make sure Coincide is open with Remote turned on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist nicht erreichbar. Stelle sicher, dass Coincide geöffnet und der Fernzugriff aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se puede acceder a %@. Asegúrate de que Coincide esté abierto y con el acceso remoto activado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se puede acceder a %@. Asegúrate de que Coincide esté abierto y con el acceso remoto activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est injoignable. Vérifiez que Coincide est ouvert et que l’accès à distance est activé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ तक नहीं पहुँचा जा सकता। पक्का करें कि Coincide खुला है और रिमोट एक्सेस चालू है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ tidak dapat dijangkau. Pastikan Coincide terbuka dengan Akses Jarak Jauh dinyalakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non è raggiungibile. Assicurati che Coincide sia aperto e che l’accesso remoto sia attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@に接続できません。Coincideが開いていて、リモートアクセスがオンになっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 연결할 수 없습니다. Coincide가 열려 있고 원격 접근이 켜져 있는지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ is niet bereikbaar. Zorg dat Coincide geopend is en externe toegang is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ jest nieosiągalny. Upewnij się, że Coincide jest otwarte, a dostęp zdalny jest włączony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ não está acessível. Verifique se o Coincide está aberto e com o acesso remoto ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ недоступен. Убедитесь, что Coincide открыт и удалённый доступ включён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ adlı Mac'e ulaşılamıyor. Coincide'ın açık ve Uzaktan Erişim'in etkin olduğundan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ недоступний. Переконайтеся, що Coincide відкрито й віддалений доступ увімкнено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Không thể truy cập %@. Hãy đảm bảo Coincide đang mở và Truy cập từ xa đã bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无法连接 %@。请确保 Coincide 已打开并开启了远程访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無法連線至 %@。請確定 Coincide 已打開並開啟遠端存取。"
          }
        }
      }
    },
    "%@ removed this device. Pair it again to connect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat dieses Gerät entfernt. Kopple es erneut, um dich zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha eliminado este dispositivo. Vuelve a enlazarlo para conectarte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ eliminó este dispositivo. Vuelve a enlazarlo para conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a retiré cet appareil. Jumelez-le à nouveau pour vous connecter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ने यह डिवाइस हटा दिया। कनेक्ट करने के लिए इसे फिर से पेयर करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ menghapus perangkat ini. Pasangkan lagi untuk terhubung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha rimosso questo dispositivo. Abbinalo di nuovo per connetterti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@からこのデバイスが削除されました。接続するには、もう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에서 이 기기를 제거했습니다. 연결하려면 다시 페어링하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ heeft dit apparaat verwijderd. Koppel het opnieuw om verbinding te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ usunął to urządzenie. Sparuj je ponownie, aby się połączyć."
