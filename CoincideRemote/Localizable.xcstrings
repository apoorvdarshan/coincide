    "Couldn’t reach %@. Make sure this device is on the same network or on Tailscale." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ konnte nicht erreicht werden. Stelle sicher, dass dieses Gerät im selben Netzwerk oder in Tailscale ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha podido acceder a %@. Asegúrate de que este dispositivo esté en la misma red o en Tailscale."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo acceder a %@. Asegúrate de que este dispositivo esté en la misma red o en Tailscale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible de joindre %@. Vérifiez que cet appareil est sur le même réseau ou sur Tailscale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ तक नहीं पहुँच सके। पक्का करें कि यह डिवाइस उसी नेटवर्क पर या Tailscale पर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidak dapat menjangkau %@. Pastikan perangkat ini berada di jaringan yang sama atau di Tailscale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossibile raggiungere %@. Assicurati che questo dispositivo sia sulla stessa rete o su Tailscale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@に接続できませんでした。このデバイスが同じネットワークまたはTailscaleに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에 연결할 수 없습니다. 이 기기가 같은 네트워크 또는 Tailscale에 연결되어 있는지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan %@ niet bereiken. Zorg dat dit apparaat op hetzelfde netwerk of op Tailscale zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można osiągnąć %@. Upewnij się, że to urządzenie jest w tej samej sieci lub w Tailscale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível acessar %@. Verifique se este dispositivo está na mesma rede ou no Tailscale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удалось связаться с %@. Убедитесь, что это устройство в той же сети или в Tailscale."
