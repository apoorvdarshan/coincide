        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le code est valable une fois, pendant quelques minutes. « Copier le code » sur le Mac le place dans votre presse-papiers grâce au Presse-papiers universel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोड सिर्फ़ एक बार, कुछ मिनटों के लिए काम करता है। Mac पर “कोड कॉपी करें” इसे यूनिवर्सल क्लिपबोर्ड से आपके क्लिपबोर्ड पर रख देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
