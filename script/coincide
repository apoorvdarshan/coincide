#!/usr/bin/env python3
"""Control the running Coincide app through its private local connection."""
import argparse
import json
import os
from pathlib import Path
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def local_action_error(command, result):
    """Only documented local recovery errors may expose an app-authored message."""
    generic = "Coincide could not complete the command."
    allowed = {
        "configuration": {"configuration_review_required", "configuration_changed", "configuration_invalid"},
        "configuration-set": {"configuration_review_required", "configuration_changed", "configuration_invalid"},
        "integrations": {"integration_refresh_required"},
        "integration-import": {"integration_refresh_required"},
        "integration-remove": {"integration_refresh_required"},
        "integration-use": {"integration_refresh_required"},
        "send": {"message_not_confirmed"},
        "compact": {"context_compaction_not_confirmed"},
        "compaction-cancel": {"context_compaction_not_confirmed"},
    }
    structured = result.get("structuredContent")
    error = structured.get("error") if isinstance(structured, dict) else None
    if not isinstance(error, dict) or not isinstance(error.get("code"), str) or error["code"] not in allowed.get(command, set()):
        return generic
    message = error.get("message")
    if not isinstance(message, str) or not message or len(message) > 4096 or any(ord(c) < 32 or ord(c) == 127 for c in message):
        return generic
    return message


def json_object(data, description):
    """Decode app-written JSON; malformed, deeply nested or non-object data is a reported error."""
    try:
        value = json.loads(data)
    except RecursionError:
        value = None
    if not isinstance(value, dict):
        raise ValueError(f"Invalid {description}.")
    return value


def connection():
    # Tests point the CLI at a disposable UI-testing app; the same privacy checks apply.
    override = os.environ.get("COINCIDE_CONTROL_DIR")
    if override is not None and not os.path.isabs(override):
        raise ValueError("COINCIDE_CONTROL_DIR must be an absolute path.")
    root = Path(override) if override else Path.home() / "Library/Application Support/Coincide/Control"
    info = root.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("The Coincide CLI directory is not private.")
    fd = os.open(root / "connection.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_nlink != 1 or info.st_size > 4096:
            raise ValueError("The Coincide CLI connection file is not private.")
        record = json_object(os.read(fd, 4096), "local Coincide connection file")
    finally:
        os.close(fd)
    endpoint = record.get("endpoint")
    url = urllib.parse.urlsplit(endpoint) if isinstance(endpoint, str) else None
    # Accept only the exact form the app writes: urlsplit silently drops tabs, newlines,
    # leading control characters and empty user info that urllib would still send.
    if url is None or not url.port or endpoint != f"http://127.0.0.1:{url.port}/mcp":
        raise ValueError("Invalid local Coincide endpoint.")
    auth = record.get("authorization", "")
    if not isinstance(auth, str) or not auth.startswith("Bearer ") or len(auth) != 50 or any(c in auth for c in "\r\n"):
        raise ValueError("Invalid local Coincide credential.")
    return record


def main():
    parser = argparse.ArgumentParser(description="Control the running Coincide app. Responses are JSON. Commands never submit or change your draft; send delivers only the text you pass, and compact asks the provider to summarize its context.")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("status", "projects", "providers"):
        commands.add_parser(name)
    integrations = commands.add_parser("integrations", help="Discover local CLI integrations; returns metadata, never credentials")
    integrations.add_argument("--kind", choices=("skills", "commands", "mcp", "plugins", "hooks"))
    integrations.add_argument("--provider", choices=("codex", "claude"))
    for name in ("integration-import", "integration-remove", "integration-use"):
        command = commands.add_parser(name, help="Import/remove a Coincide library item, or add it to the selected draft without sending")
        command.add_argument("integration_id", help="Exact ID returned by integrations")
    sessions = commands.add_parser("sessions", help="List provider-owned sessions without starting a daemon or model turn")
    sessions.add_argument("provider", choices=("codex", "claude"))
    for name in ("session-details", "session-stop"):
        command = commands.add_parser(name, help="Inspect a provider session or explicitly stop its current work")
        command.add_argument("provider", choices=("codex", "claude"))
        command.add_argument("session_id", help="Exact ID returned by sessions, including its provider prefix")
        if name == "session-stop":
            command.add_argument("--confirm", action="store_true", required=True,
                                 help="Confirm this affects the original provider session")
    configuration = commands.add_parser("configuration", help="Read safe structured settings and obtain a short-lived review ID")
    configuration.add_argument("provider", choices=("codex", "claude"))
    configuration.add_argument("--scope", choices=("user", "project", "local"), default="user")
    config_set = commands.add_parser("configuration-set", help="Save one reviewed setting; rejects stale source files and sensitive values")
    config_set.add_argument("review_id", type=lambda value: str(uuid.UUID(value)))
    config_set.add_argument("field", help="Exact field ID from configuration")
    config_set.add_argument("value", help="Validated setting value; empty string removes this scope's override")
    threads = commands.add_parser("threads")
    threads.add_argument("--project", help="Project name, path, or UUID")
    send = commands.add_parser("send", help="Send this text to the conversation's agent; may use model tokens. Your unsent draft is kept")
    send.add_argument("text")
    send.add_argument("--thread", dest="id", help="Conversation UUID; defaults to the selected conversation")
    send.add_argument("--confirm", action="store_true", required=True, help="Confirm sending the text to the provider")
    compaction = commands.add_parser("compaction", help="Read current compaction eligibility and saved operation status")
    compaction.add_argument("--thread", dest="id", help="Conversation UUID; defaults to the selected conversation")
    compact = commands.add_parser("compact", help="Ask the idle app-owned provider session to compact context; may use model tokens")
    compact.add_argument("--thread", dest="id", help="Conversation UUID; defaults to the selected conversation")
    compact.add_argument("--confirm", action="store_true", required=True,
                         help="Confirm provider-context summarization; the visible transcript and draft remain unchanged")
    cancel_compaction = commands.add_parser("compaction-cancel", help="Stop only the specified current compaction operation; a dispatched result may remain unconfirmed")
    cancel_compaction.add_argument("--thread", dest="id", help="Conversation UUID; defaults to the selected conversation")
    cancel_compaction.add_argument("--operation", type=lambda value: str(uuid.UUID(value)), required=True,
                                   help="Exact operation ID returned by compaction")
    cancel_compaction.add_argument("--confirm", action="store_true", required=True)
    for name in ("thread", "select", "models"):
        command = commands.add_parser(name)
        command.add_argument("id", nargs="?", help="Conversation UUID; defaults to the selected conversation")
        if name == "models":
            command.add_argument("--all", action="store_true", help="List models from both configured CLIs")
            command.add_argument("--refresh", action="store_true", help="Refresh the selected conversation's provider catalog without sending a prompt")
    new = commands.add_parser("new", help="Create an empty conversation in a local folder")
    new.add_argument("path", nargs="?", default=".")
    model = commands.add_parser("model", help="Select an advertised model and its provider without sending a prompt")
    model.add_argument("provider", choices=("codex", "claude"))
    model.add_argument("model", help="Model ID from models --all; an empty string uses the CLI default")
    model.add_argument("--thread", dest="id", help="Conversation UUID; defaults to the selected conversation")
    sort = commands.add_parser("sort", help="Read or save independent sidebar sort choices")
    sort.add_argument("--projects", choices=("newest", "active", "priority", "name", "custom"))
    sort.add_argument("--chats", choices=("newest", "active", "priority", "name", "custom"))
    moving = sort.add_mutually_exclusive_group()
    moving.add_argument("--move-chat", type=lambda value: str(uuid.UUID(value)), help="Move a visible chat in Custom order")
    moving.add_argument("--move-project", type=lambda value: str(uuid.UUID(value)), help="Move a project in Custom order")
    sort.add_argument("--direction", choices=("up", "down"), help="Required with --move-chat or --move-project")
    ui = commands.add_parser("ui", help="Navigate the native chat and settings without clicking")
    destination = ui.add_mutually_exclusive_group()
    destination.add_argument("--chat", action="store_true")
    destination.add_argument("--settings", choices=("general", "appearance", "notifications", "providers", "models", "conversations", "keyboard", "about", "skills", "commands", "mcp", "plugins", "hooks", "configuration", "sessions"))
    ui.add_argument("--sidebar", choices=("show", "hide"))
    ui.add_argument("--display", choices=("built-in",), help="Fit the existing window to the Mac's built-in display without activating it")
    ui.add_argument("--model-picker", action="store_true", help="Open the unified model picker")
    screenshot = commands.add_parser("screenshot", help="Render the app window to a new PNG file without computer-use automation")
    screenshot.add_argument("path")
    screenshot.add_argument("--popover", action="store_true", help="Capture the one visible native popover")
    export = commands.add_parser("export", help="Export visible conversation text to a new private file; never overwrites")
    export.add_argument("path")
    export.add_argument("--format", choices=("markdown", "json"), default="markdown")
    export.add_argument("--thread", dest="id", help="Conversation UUID; defaults to the selected conversation")
    options = vars(parser.parse_args())
    name = options.pop("command")
    arguments = {k: v for k, v in options.items() if v is not None}
    if "id" in arguments:
        arguments["id"] = str(uuid.UUID(arguments["id"]))
    if "path" in arguments:
        try:
            arguments["path"] = str(Path(arguments["path"]).expanduser().absolute())
        except RuntimeError:  # "~name/..." for an account without a home folder
            raise ValueError("Could not find the home folder in that path.") from None
    record = connection()
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())

    def rpc(method, params, notification=False):
        payload = {"jsonrpc": "2.0", "method": method, "params": params}
        if not notification:
            payload["id"] = str(uuid.uuid4())
        request = urllib.request.Request(record["endpoint"], data=json.dumps(payload).encode(), headers={
            "Authorization": record["authorization"], "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream", "MCP-Protocol-Version": "2025-11-25"})
        # A lost reply is never retried: 'new' might already have created a chat.
        with opener.open(request, timeout=35) as response:
            data = response.read(1_048_577)
        if len(data) > 1_048_576:
            raise ValueError("Coincide response exceeded the size limit.")
        if notification:
            return None
        reply = json_object(data, "Coincide response")
        if "error" in reply:
            error = reply["error"]
            raise ValueError(error.get("message", "Coincide rejected the request.") if isinstance(error, dict) else "Coincide rejected the request.")
        if not isinstance(reply.get("result"), dict):
            raise ValueError("Invalid Coincide response.")
        return reply["result"]

    rpc("initialize", {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "coincide-cli", "version": "1"}})
    rpc("notifications/initialized", {}, notification=True)
    result = rpc("tools/call", {"name": name, "arguments": arguments})
    if result.get("isError"):
        raise ValueError(local_action_error(name, result))
    print(json.dumps(result.get("structuredContent"), indent=2, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except FileNotFoundError:
        sys.exit("coincide: Open the updated Coincide app first; its local CLI connection is unavailable.")
    except (urllib.error.URLError, TimeoutError):
        sys.exit("coincide: The app did not confirm the request. Check status/threads before repeating a change.")
    except (ValueError, KeyError, OSError) as error:
        sys.exit("coincide: " + str(error))
