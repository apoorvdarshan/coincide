// The coincide.dev website: static files in public/, served by Cloudflare Workers, plus worker/index.js for the
// platform-interest counter (/api/interest). Deploy from this folder with `wrangler deploy`.
{
  "name": "coincide-website",
  "compatibility_date": "2026-10-30",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "coincide.dev", "custom_domain": true },
    { "pattern": "www.coincide.dev", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "INTEREST", "class_name": "InterestCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InterestCounter"] }],
  "workers_dev": false,
  "preview_urls": false
}
