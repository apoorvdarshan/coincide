// The coincide.dev website: static files in public/, served by Cloudflare Workers.
// Deploy from this folder with `wrangler deploy`.
{
  "name": "coincide-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "coincide.dev", "custom_domain": true },
    { "pattern": "www.coincide.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
