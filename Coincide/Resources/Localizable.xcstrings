          }
        }
      }
    },
    "Allow the battery helper in Login Items. Until then the Mac stays awake on battery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaube den Batterie-Helfer in den Anmeldeobjekten. Bis dahin bleibt der Mac auch mit Batterie wach."
