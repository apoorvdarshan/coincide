          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके संगठन की उपयोग और लागत रिपोर्ट तक केवल पढ़ने की पहुँच, जो सेटिंग्स › उपयोग में दिखती हैं। कीचेन में रखी जाती है और सिर्फ़ Anthropic को भेजी जाती है।"
