    "Allow the agent to sign in to %@ with %@ login “%@”? Coincide types the password; the agent never sees it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Darf der Agent sich bei %1$@ mit der %2$@-Anmeldung „%3$@“ anmelden? Coincide tippt das Passwort ein; der Agent sieht es nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow the agent to sign in to %1$@ with %2$@ login “%3$@”? Coincide types the password; the agent never sees it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Permitir que el agente inicie sesión en %1$@ con el inicio de sesión de %2$@ “%3$@”? Coincide escribe la contraseña; el agente nunca la ve."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Permitir que el agente inicie sesión en %1$@ con el inicio de sesión de %2$@ “%3$@”? Coincide escribe la contraseña; el agente nunca la ve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autoriser l’agent à se connecter à %1$@ avec l’identifiant %2$@ « %3$@ » ? Coincide saisit le mot de passe ; l’agent ne le voit jamais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्या एजेंट को %2$@ लॉगिन “%3$@” से %1$@ में साइन इन करने दें? पासवर्ड Coincide टाइप करता है; एजेंट उसे कभी नहीं देखता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Izinkan agen masuk ke %1$@ dengan login %2$@ “%3$@”? Coincide mengetik kata sandinya; agen tidak pernah melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consentire all’agente di accedere a %1$@ con l’accesso %2$@ “%3$@”? Coincide digita la password; l’agente non la vede mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントが %2$@ のログイン「%3$@」で %1$@ にサインインすることを許可しますか？パスワードは Coincide が入力し、エージェントには見えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트가 %2$@ 로그인 ‘%3$@’(으)로 %1$@에 로그인하도록 허용할까요? 암호는 Coincide가 입력하며 에이전트는 볼 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De agent laten inloggen op %1$@ met de %2$@-aanmelding ‘%3$@’? Coincide typt het wachtwoord; de agent ziet het nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozwolić agentowi zalogować się do %1$@ przy użyciu danych %2$@ „%3$@”? Hasło wpisuje Coincide; agent nigdy go nie widzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permitir que o agente faça login em %1$@ com o login do %2$@ “%3$@”? O Coincide digita a senha; o agente nunca a vê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Разрешить агенту войти на %1$@ с данными %2$@ «%3$@»? Пароль вводит Coincide; агент его не видит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajanın %2$@ girişi “%3$@” ile %1$@ sitesinde oturum açmasına izin verilsin mi? Parolayı Coincide yazar; ajan onu hiç görmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дозволити агенту увійти на %1$@ з даними %2$@ «%3$@»? Пароль вводить Coincide; агент його не бачить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cho phép agent đăng nhập vào %1$@ bằng thông tin %2$@ “%3$@”? Coincide tự nhập mật khẩu; agent không bao giờ thấy nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "允许代理使用 %2$@ 登录项“%3$@”登录 %1$@ 吗？密码由 Coincide 填写，代理永远看不到。"
          }
