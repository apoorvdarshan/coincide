        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halo. Apa yang Anda perlukan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciao. Di cosa hai bisogno?"
