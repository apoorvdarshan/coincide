          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Định hướng: gửi vào lượt hiện tại (%1$@). %2$@ sẽ xếp tin nhắn vào hàng đợi cho sau lượt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "引导：发送到当前轮次（%1$@）。%2$@ 则会将其排队，待本轮结束后发送。"
