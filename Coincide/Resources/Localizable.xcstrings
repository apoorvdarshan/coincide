          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dostawcy, własne modele i domyślny model nowych wątków zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Provedores, modelos personalizados e o modelo padrão para novas conversas são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Провайдеры, свои модели и модель по умолчанию для новых чатов сохранятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
