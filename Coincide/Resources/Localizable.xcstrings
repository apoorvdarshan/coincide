    "Speak and watch the level move. Nothing is recorded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sprich und beobachte, wie sich der Pegel bewegt. Es wird nichts aufgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Habla y observa cómo se mueve el nivel. No se graba nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Habla y observa cómo se mueve el nivel. No se graba nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parlez et regardez le niveau bouger. Rien n’est enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बोलें और लेवल को हिलते देखें। कुछ भी रिकॉर्ड नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bicaralah dan lihat levelnya bergerak. Tidak ada yang direkam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parla e osserva il livello che si muove. Non viene registrato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "話してレベルが動くのを確認してください。録音はされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "말하면서 레벨이 움직이는지 확인하십시오. 아무것도 녹음되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spreek en kijk hoe het niveau beweegt. Er wordt niets opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mów i obserwuj, jak zmienia się poziom. Nic nie jest nagrywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fale e veja o nível se mover. Nada é gravado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Говорите и следите за уровнем. Ничего не записывается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konuşun ve seviyenin hareket etmesini izleyin. Hiçbir şey kaydedilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Говоріть і стежте за рівнем. Нічого не записується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hãy nói và xem mức âm lượng thay đổi. Không có gì được ghi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "说话时观察音量变化。不会录制任何内容。"
