        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "兩個指令使用相同快速鍵時，已更改的快速鍵會優先於預設快速鍵。「拷貝」等固定的選單快速鍵會保留其按鍵。"
          }
        }
      }
    },
    "When you ask an agent to do something later or on a schedule, it waits for you to allow it in the thread before it can run." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du einen Agenten bittest, etwas später oder regelmäßig zu erledigen, wartet das im Thread auf deine Erlaubnis, bevor es ausgeführt werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando pides a un agente que haga algo más tarde o de forma periódica, la tarea espera a que la permitas en la conversación antes de ejecutarse."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando pides a un agente que haga algo más tarde o de forma periódica, la tarea espera a que la permitas en la conversación antes de ejecutarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quand vous demandez à un agent de faire quelque chose plus tard ou à intervalles réguliers, la tâche attend votre autorisation dans la discussion avant de pouvoir s’exécuter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब आप किसी एजेंट से कोई काम बाद में या तय समय पर करने को कहते हैं, तो चलने से पहले वह थ्रेड में आपकी अनुमति का इंतज़ार करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saat Anda meminta agen melakukan sesuatu nanti atau sesuai jadwal, jadwal itu menunggu izin Anda di utas sebelum dapat berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando chiedi a un agente di fare qualcosa più tardi o a intervalli regolari, l’attività attende il tuo consenso nel thread prima di poter essere eseguita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "後で、または定期的に何かを行うようエージェントに依頼すると、実行前にスレッド内であなたの許可を待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트에게 나중에 또는 일정에 따라 작업하도록 요청하면, 실행하기 전에 스레드에서 사용자의 허용을 기다립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je een agent vraagt iets later of volgens een schema te doen, wacht dat tot je het in de thread toestaat voordat het kan worden uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdy poprosisz agenta, aby zrobił coś później albo cyklicznie, przed uruchomieniem zaczeka na Twoją zgodę w wątku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando você pede a um agente para fazer algo mais tarde ou em horários definidos, ele aguarda a sua permissão na conversa antes de ser executado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Когда вы просите агента сделать что-нибудь позже или по расписанию, перед запуском он ждёт вашего разрешения в чате."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
