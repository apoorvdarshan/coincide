          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voor inloggen, CAPTCHA’s en tweestapscodes vragen agents jou het over te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przy logowaniu, CAPTCHA i kodach dwuskładnikowych agenci proszą Cię o przejęcie."
