        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बॉट कौन है और कैसे काम करता है। इसके एजेंट को यह हर सेशन की शुरुआत में मिलता है; यह बातचीत में कभी नहीं दिखता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siapa bot ini dan cara kerjanya. Agennya menerima ini di awal setiap sesi; teks ini tidak pernah ditampilkan dalam percakapan."
