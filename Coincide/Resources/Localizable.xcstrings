    "Pressing both ⌘ keys for Appshots would also start dictation. Choose another key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Drücken beider ⌘-Tasten für Appshots würde auch das Diktat starten. Wähle eine andere Taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pulsar las dos teclas ⌘ para Appshots también iniciaría el dictado. Elige otra tecla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Presionar las dos teclas ⌘ para Appshots también iniciaría el dictado. Elige otra tecla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appuyer sur les deux touches ⌘ pour Appshots lancerait aussi la dictée. Choisissez une autre touche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appshots के लिए दोनों ⌘ कुंजियाँ दबाने से डिक्टेशन भी शुरू हो जाएगा। कोई दूसरी कुंजी चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menekan kedua tombol ⌘ untuk Appshots juga akan memulai dikte. Pilih tombol lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premere entrambi i tasti ⌘ per Appshots avvierebbe anche la dettatura. Scegli un altro tasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appshots のために両方の ⌘ キーを押すと、音声入力も開始されます。別のキーを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appshots를 위해 ⌘ 키 두 개를 누르면 받아쓰기도 시작됩니다. 다른 키를 선택하세요."
