    "Models appear here once %@ is installed and signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modelle erscheinen hier, sobald %@ installiert und angemeldet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los modelos aparecen aquí cuando %@ está instalado y con la sesión iniciada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los modelos aparecen aquí cuando %@ está instalado y tiene una sesión iniciada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modèles apparaissent ici une fois %@ installé et connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ के इंस्टॉल और साइन इन होने के बाद मॉडल यहाँ दिखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model muncul di sini setelah %@ terinstal dan masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I modelli appaiono qui dopo che %@ è stato installato e ha effettuato l'accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@をインストールしてサインインすると、ここにモデルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@을(를) 설치하고 로그인하면 모델이 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modellen verschijnen hier zodra %@ is geïnstalleerd en ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modele pojawią się tutaj, gdy %@ zostanie zainstalowany i zalogowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os modelos aparecem aqui assim que o %@ for instalado e você fizer login."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Модели появятся здесь, когда %@ будет установлен и вход будет выполнен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ yüklenip giriş yapıldığında modeller burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Моделі з’являться тут, щойно %@ буде встановлено й виконано вхід."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mô hình sẽ xuất hiện ở đây khi %@ được cài đặt và đăng nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "安装并登录 %@ 后，模型会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 安裝並登入後，模型會顯示在這裡。"
          }
        }
      }
    },
    "Models your providers offer, plus custom model IDs you add. Right-click a model to use it for new threads, star it, or hide it from the model picker." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modelle deiner Anbieter und selbst hinzugefügte Modell-IDs. Klicke mit der rechten Maustaste auf ein Modell, um es für neue Threads zu verwenden, als Favorit zu markieren oder in der Modellauswahl auszublenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modelos de tus proveedores y los ID de modelos personalizados que añadas. Haz clic derecho en un modelo para usarlo en hilos nuevos, marcarlo como favorito u ocultarlo del selector de modelos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modelos de tus proveedores y los ID de modelos personalizados que agregues. Haz clic derecho en un modelo para usarlo en conversaciones nuevos, marcarlo como favorito u ocultarlo del selector de modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modèles de vos fournisseurs et les identifiants personnalisés que vous ajoutez. Faites un clic droit sur un modèle pour l’utiliser dans de nouveaux fils, l’ajouter aux favoris ou le masquer du sélecteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके प्रदाताओं के मॉडल और आपके जोड़े गए कस्टम मॉडल आईडी। नए थ्रेड में उपयोग करने, पसंदीदा बनाने या मॉडल चयन से छिपाने के लिए मॉडल पर दायाँ क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Model dari penyedia Anda dan ID model khusus yang Anda tambahkan. Klik kanan model untuk menggunakannya pada percakapan baru, menandainya sebagai favorit, atau menyembunyikannya dari pemilih model."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I modelli dei tuoi fornitori e gli ID personalizzati che aggiungi. Fai clic destro su un modello per usarlo nei nuovi thread, aggiungerlo ai preferiti o nasconderlo dal selettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プロバイダーのモデルと、追加したカスタムモデル ID です。モデルを右クリックすると、新しいスレッドで使用したり、お気に入りに追加したり、モデル選択から非表示にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "제공업체의 모델과 직접 추가한 사용자 지정 모델 ID입니다. 모델을 오른쪽 클릭하여 새 스레드에 사용하거나, 즐겨찾기에 추가하거나, 모델 선택기에서 숨길 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modellen van je aanbieders en zelf toegevoegde model-ID’s. Klik met rechts op een model om het voor nieuwe threads te gebruiken, als favoriet te markeren of in de modelkiezer te verbergen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modele dostawców i dodane przez Ciebie niestandardowe identyfikatory modeli. Kliknij model prawym przyciskiem, aby używać go w nowych wątkach, dodać do ulubionych lub ukryć w wyborze modeli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modelos dos seus provedores e IDs de modelos personalizados que você adicionar. Clique com o botão direito em um modelo para usá-lo em novas conversas, marcá-lo como favorito ou ocultá-lo do seletor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Модели ваших поставщиков и добавленные вами идентификаторы моделей. Нажмите на модель правой кнопкой, чтобы использовать её в новых ветках, добавить в избранное или скрыть в выборе моделей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sağlayıcılarınızın modelleri ve eklediğiniz özel model kimlikleri. Yeni konularda kullanmak, favorilere eklemek veya model seçiciden gizlemek için modele sağ tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Моделі ваших постачальників і додані вами ідентифікатори моделей. Натисніть модель правою кнопкою, щоб використовувати її в нових гілках, додати до улюблених або приховати у виборі моделей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mô hình từ nhà cung cấp và ID mô hình tùy chỉnh bạn thêm. Nhấp chuột phải vào mô hình để dùng cho luồng mới, đánh dấu yêu thích hoặc ẩn khỏi bộ chọn mô hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "提供商的模型以及你添加的自定义模型 ID。右键点击模型，可将其用于新会话、添加到收藏或从模型选择器中隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "供應商的模型，以及你加入的自訂模型 ID。右鍵點擊模型，可將其用於新對話、加入收藏或從模型選擇器中隱藏。"
          }
        }
      }
    },
