        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Доступ только для чтения к отчётам об использовании и расходах вашей организации в разделе Настройки › Использование. Хранится в связке ключей и отправляется только в Anthropic."
          }
        },
        "tr" : {
