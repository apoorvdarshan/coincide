    "%@ already exists and isn’t Coincide’s tool, so it was left alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ existiert bereits und ist nicht das Werkzeug von Coincide; es wurde nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ya existe y no es la herramienta de Coincide, así que no se tocó."
