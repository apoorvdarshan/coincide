          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スレッドの履歴は保持されます。Antigravityは次のターンの前に再度サインインを求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스레드 기록은 유지됩니다. Antigravity는 다음 턴 전에 다시 로그인하도록 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
