        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hallo. Wat heb je nodig?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cześć. Czego potrzebujesz?"
