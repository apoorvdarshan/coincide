    "You can undo this deletion until Coincide quits or the undo history is cleared. Files in your project are not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst diese Löschung rückgängig machen, bis Coincide beendet oder der Rückgängig-Verlauf geleert wird. Dateien in deinem Projekt werden nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes deshacer esta eliminación hasta que se cierre Coincide o se borre el historial de deshacer. Los archivos de tu proyecto no cambian."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes deshacer esta eliminación hasta que se cierre Coincide o se borre el historial de deshacer. Los archivos de tu proyecto no cambian."
