          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agent sẽ nhờ bạn tiếp quản khi cần đăng nhập, CAPTCHA và mã xác thực hai yếu tố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "遇到登录、CAPTCHA 和双重验证码时，代理会请你接手。"
