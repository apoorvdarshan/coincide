          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AntigravityはGoogleアカウントのサブスクリプションを使用します。Coincideはこのサインイン情報を独自のAntigravityプロファイルに保存し、~/.geminiやほかのAntigravityのインストールとは分けて管理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
