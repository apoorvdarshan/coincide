        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antigravity menggunakan langganan akun Google Anda. Coincide menyimpan info masuk ini di profil Antigravity miliknya sendiri, terpisah dari ~/.gemini dan instalasi Antigravity lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
