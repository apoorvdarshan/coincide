    "Coincide never quits or reopens automatically. The previous app is kept as a backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide wird niemals automatisch beendet oder erneut geöffnet. Die vorherige App bleibt als Sicherung erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
