    "Coincide runs each agent’s own command-line tool with the account you already signed in to. It never sells or proxies tokens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide führt das eigene Befehlszeilentool jedes Agenten mit dem Account aus, bei dem du dich bereits angemeldet hast. Es verkauft oder vermittelt niemals Tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide ejecuta la herramienta de línea de comandos de cada agente con la cuenta con la que ya has iniciado sesión. Nunca vende ni redirige tokens."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide ejecuta la herramienta de línea de comandos de cada agente con la cuenta en la que ya iniciaste sesión. Nunca vende ni redirige tokens."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
