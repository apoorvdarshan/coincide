          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiadomości wysłane podczas pracy agenta trafiają do jego bieżącej tury, jeśli może je przyjąć. Shift-Command-Return zamiast tego dodaje wiadomość do kolejki na czas po zakończeniu tury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As mensagens enviadas enquanto um agente trabalha entram no turno atual, se ele puder recebê-las. Shift-Command-Return põe uma na fila para depois do turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сообщения, отправленные во время работы агента, попадают в текущий ход, если агент может их принять. Shift-Command-Return вместо этого ставит сообщение в очередь до конца хода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajan çalışırken gönderilen mesajlar, alabiliyorsa geçerli turuna eklenir. Shift-Command-Return ise mesajı tur bitince gönderilmek üzere sıraya alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повідомлення, надіслані під час роботи агента, потрапляють у поточний хід, якщо агент може їх прийняти. Shift-Command-Return натомість ставить повідомлення в чергу до завершення ходу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tin nhắn gửi khi agent đang làm việc sẽ đi vào lượt hiện tại của agent, nếu agent có thể nhận. Shift-Command-Return sẽ đưa tin nhắn vào hàng đợi cho sau lượt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "智能体工作时发送的消息会进入其当前轮次（如果它能接收）。按 Shift-Command-Return 则会将消息排队，待本轮结束后发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "代理程式工作期間傳送的訊息，若代理程式可以接收，會送入目前的回合。按 Shift-Command-Return 則會將訊息排入佇列，待回合結束後傳送。"
          }
        }
      }
    },
    "Messages sent while an agent works stop its current turn and go next. Command-Return queues one for after the turn instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nachrichten, die während der Arbeit eines Agenten gesendet werden, stoppen seinen aktuellen Durchgang und kommen als Nächstes. Befehl-Return reiht eine stattdessen für nach dem Durchgang ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes enviados mientras un agente trabaja detienen su turno actual y van a continuación. Comando-Retorno pone uno en cola para después del turno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes enviados mientras un agente trabaja detienen su turno actual y van a continuación. Comando-Retorno pone uno en cola para después del turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les messages envoyés pendant qu’un agent travaille arrêtent son tour en cours et passent ensuite. Commande-Retour en met un en file pour après le tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी एजेंट के काम करते समय भेजे गए संदेश उसका मौजूदा टर्न रोककर अगले भेजे जाते हैं। Command-Return किसी संदेश को टर्न के बाद के लिए कतार में रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pesan yang dikirim saat agen bekerja menghentikan giliran saat ini dan dikirim berikutnya. Command-Return mengantrekan satu pesan untuk setelah giliran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I messaggi inviati mentre un agente lavora interrompono il suo turno corrente e vanno subito dopo. Comando-Invio ne mette uno in coda per dopo il turno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントの作業中に送ったメッセージは、現在のターンを停止して次に送られます。Command-Return でターン後に送るようキューに入れられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트가 작업하는 동안 보낸 메시지는 현재 턴을 중지하고 다음으로 보내집니다. Command-Return은 메시지를 턴 이후로 대기열에 넣습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berichten die je stuurt terwijl een agent werkt, stoppen zijn huidige beurt en gaan als volgende. Command-Return zet er een in de wachtrij voor na de beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiadomości wysłane podczas pracy agenta zatrzymują jego bieżącą turę i idą jako następne. Command-Return dodaje wiadomość do kolejki na po turze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mensagens enviadas enquanto um agente trabalha param o turno atual e vão em seguida. Command-Return coloca uma na fila para depois do turno."
          }
        },
        "ru" : {
