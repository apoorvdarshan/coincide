    "Your Google sign-in and thread history are kept. You can install the runtime again at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Google-Anmeldung und der Thread-Verlauf bleiben erhalten. Du kannst die Laufzeitumgebung jederzeit erneut installieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conservan tu inicio de sesión de Google y el historial de conversaciones. Puedes volver a instalar el runtime en cualquier momento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conservan tu inicio de sesión con Google y el historial de conversaciones. Puedes volver a instalar el runtime en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre connexion Google et l'historique des discussions sont conservés. Vous pouvez réinstaller le runtime à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपका Google साइन इन और थ्रेड इतिहास बना रहता है। आप रनटाइम कभी भी फिर से इंस्टॉल कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Info masuk Google dan riwayat utas Anda tetap disimpan. Anda dapat menginstal runtime lagi kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'accesso a Google e la cronologia dei thread vengono mantenuti. Puoi reinstallare il runtime in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Googleのサインイン情報とスレッドの履歴は保持されます。ランタイムはいつでも再インストールできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Google 로그인 및 스레드 기록은 유지됩니다. 언제든지 런타임을 다시 설치할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je Google-login en threadgeschiedenis blijven behouden. Je kunt de runtime op elk moment opnieuw installeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje logowanie Google i historia wątków zostaną zachowane. Środowisko uruchomieniowe możesz zainstalować ponownie w dowolnym momencie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seu login do Google e o histórico das conversas são mantidos. Você pode instalar o runtime novamente a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вход через Google и история чатов сохранятся. Среду выполнения можно установить снова в любое время."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Google girişiniz ve sohbet geçmişiniz korunur. Çalışma ortamını istediğiniz zaman yeniden yükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вхід у Google та історія чатів зберігаються. Середовище виконання можна встановити знову будь-коли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thông tin đăng nhập Google và lịch sử luồng của bạn được giữ lại. Bạn có thể cài đặt lại runtime bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 Google 登录信息和对话历史记录将保留。你可以随时重新安装运行时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 Google 登入資訊和對話記錄會保留。你隨時可以重新安裝執行環境。"
          }
        }
      }
    },
    "Your changes are lost if you don't save them." : {
      "localizations" : {
        "de" : {
