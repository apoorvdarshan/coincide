    "Press the left and right ⌘ keys together, without other keys." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Drücke die linke und die rechte ⌘-Taste gleichzeitig, ohne weitere Tasten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pulsa las teclas ⌘ izquierda y derecha a la vez, sin otras teclas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Presiona las teclas ⌘ izquierda y derecha a la vez, sin otras teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appuyez simultanément sur les touches ⌘ gauche et droite, sans autre touche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बाईं और दाईं ⌘ कुंजियाँ एक साथ दबाएँ, कोई और कुंजी नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tekan tombol ⌘ kiri dan kanan bersamaan, tanpa tombol lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premi insieme i tasti ⌘ sinistro e destro, senza altri tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "左右の⌘キーを同時に押してください。ほかのキーは押さないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다른 키 없이 왼쪽과 오른쪽 ⌘ 키를 함께 누르십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Druk tegelijk op de linker- en rechter-⌘-toets, zonder andere toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naciśnij jednocześnie lewy i prawy klawisz ⌘, bez innych klawiszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pressione as teclas ⌘ esquerda e direita juntas, sem outras teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
