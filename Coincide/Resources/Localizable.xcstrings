          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide 未获准使用语音识别。请在“系统设置” › “隐私与安全性” › “语音识别”中打开。"
          }
        },
        "zh-Hant" : {
