        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डिक्टेशन खत्म होते ही संदेश भेज देता है। बंद होने पर टेक्स्ट संदेश बॉक्स में रहता है ताकि आप उसे जाँच सकें।"
