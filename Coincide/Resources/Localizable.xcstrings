    "Ooh, something new? Tell me more. What are we exploring?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oh, etwas Neues? Erzähl mehr. Was erkunden wir?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uy, ¿algo nuevo? Cuéntame más. ¿Qué vamos a explorar?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uy, ¿algo nuevo? Cuéntame más. ¿Qué vamos a explorar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oh, du nouveau ? Dites-m’en plus. Qu’allons-nous explorer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अरे, कुछ नया? और बताइए। आज हम क्या खोजेंगे?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wah, sesuatu yang baru? Ceritakan lagi. Kita mau menjelajahi apa?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oh, qualcosa di nuovo? Raccontami. Cosa esploriamo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "おっ、何か新しいこと？もっと聞かせて。何を探検しましょうか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오, 뭔가 새로운 거예요? 더 들려주세요. 무엇을 탐험해 볼까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ooh, iets nieuws? Vertel meer. Wat gaan we verkennen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oo, coś nowego? Opowiedz więcej. Co odkrywamy?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opa, algo novo? Conta mais. O que vamos explorar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "О, что-то новенькое? Расскажите подробнее. Что исследуем?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ooo, yeni bir şey mi? Biraz daha anlatın. Neyi keşfediyoruz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "О, щось новеньке? Розкажіть більше. Що досліджуємо?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ồ, có gì mới à? Kể thêm đi. Mình đang khám phá gì đây?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "哇，有新东西？快多讲讲。我们要探索什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "哇，有新東西？多說一點吧。我們要探索什麼？"
          }
        }
      }
