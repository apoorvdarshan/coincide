        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "机器人是一段持续进行的对话，拥有自己的个性和职责。它像其他对话一样由你的智能体运行。"
          }
        },
        "zh-Hant" : {
