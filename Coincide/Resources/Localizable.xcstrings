    "Sends a one-token message to read the key’s per-minute limits from Anthropic’s answer. It costs a fraction of a cent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sendet eine Nachricht mit einem Token, um die Minutenlimits des Schlüssels aus der Antwort von Anthropic zu lesen. Das kostet einen Bruchteil eines Cents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía un mensaje de un token para leer los límites por minuto de la clave en la respuesta de Anthropic. Cuesta una fracción de céntimo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía un mensaje de un token para leer los límites por minuto de la clave en la respuesta de Anthropic. Cuesta una fracción de centavo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoie un message d’un token pour lire les limites par minute de la clé dans la réponse d’Anthropic. Cela coûte une fraction de centime."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anthropic के जवाब से कुंजी की प्रति-मिनट सीमाएँ पढ़ने के लिए एक-टोकन संदेश भेजता है। इसकी लागत एक सेंट का छोटा-सा हिस्सा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengirim pesan satu token untuk membaca batas per menit kunci dari jawaban Anthropic. Biayanya hanya sepersekian sen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Invia un messaggio di un token per leggere i limiti al minuto della chiave dalla risposta di Anthropic. Costa una frazione di centesimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1トークンのメッセージを送信し、Anthropicの応答からキーの1分あたりの上限を読み取ります。費用は1セント未満です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1토큰 메시지를 보내 Anthropic의 응답에서 키의 분당 한도를 읽어 옵니다. 비용은 1센트 미만입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stuurt een bericht van één token om de minuutlimieten van de sleutel uit het antwoord van Anthropic te lezen. Dat kost een fractie van een cent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wysyła wiadomość z jednym tokenem, aby odczytać minutowe limity klucza z odpowiedzi Anthropic. Kosztuje to ułamek centa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envia uma mensagem de um token para ler os limites por minuto da chave na resposta da Anthropic. Custa uma fração de centavo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отправляет сообщение из одного токена, чтобы узнать поминутные лимиты ключа из ответа Anthropic. Это стоит долю цента."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anahtarın dakikalık sınırlarını Anthropic’in yanıtından okumak için tek token’lık bir mesaj gönderir. Maliyeti bir sentin küçük bir kısmıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Надсилає повідомлення з одного токена, щоб дізнатися похвилинні ліміти ключа з відповіді Anthropic. Це коштує частку цента."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gửi một tin nhắn một token để đọc giới hạn mỗi phút của khóa từ phản hồi của Anthropic. Chi phí chỉ là một phần nhỏ của một xu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "发送一条单令牌消息，从 Anthropic 的回复中读取该密钥的每分钟限制。费用不到一美分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "傳送一則單一權杖的訊息，從 Anthropic 的回應讀取金鑰的每分鐘限制。費用不到一美分。"
          }
        }
      }
    },
    "Sends the message as soon as dictation ends. Off, the text waits in the composer for you to check." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sendet die Nachricht, sobald das Diktat endet. Ist es aus, wartet der Text im Eingabefeld, damit du ihn prüfen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía el mensaje en cuanto termina el dictado. Si está desactivado, el texto espera en el cuadro de mensaje para que lo revises."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía el mensaje en cuanto termina el dictado. Si está desactivado, el texto espera en el cuadro de mensaje para que lo revises."
