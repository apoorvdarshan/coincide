          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhấn cả hai phím ⌘ cho Appshots cũng sẽ bắt đầu đọc chính tả. Hãy chọn phím khác."
          }
