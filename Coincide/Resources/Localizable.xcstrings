    "Interrupt: stop the current turn and send this now (%@). %@ queues it for after the turn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unterbrechen: aktuellen Durchgang stoppen und dies jetzt senden (%1$@). %2$@ reiht es für nach dem Durchgang ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Interrupt: stop the current turn and send this now (%1$@). %2$@ queues it for after the turn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interrumpir: detener el turno actual y enviar esto ahora (%1$@). %2$@ lo pone en cola para después del turno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interrumpir: detener el turno actual y enviar esto ahora (%1$@). %2$@ lo pone en cola para después del turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interrompre : arrêter le tour en cours et envoyer ceci maintenant (%1$@). %2$@ le met en file pour après le tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बीच में रोकें: मौजूदा टर्न रोकें और इसे अभी भेजें (%1$@)। %2$@ इसे टर्न के बाद के लिए कतार में रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sela: hentikan giliran saat ini dan kirim ini sekarang (%1$@). %2$@ mengantrekannya untuk setelah giliran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interrompi: ferma il turno corrente e invia ora (%1$@). %2$@ lo mette in coda per dopo il turno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "中断: 現在のターンを停止して今すぐ送信 (%1$@)。%2$@ でターン後に送るようキューに入れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "중단: 현재 턴을 중지하고 지금 보내기 (%1$@). %2$@은(는) 턴 이후로 대기열에 넣습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Onderbreken: stop de huidige beurt en verstuur dit nu (%1$@). %2$@ zet het in de wachtrij voor na de beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przerwij: zatrzymaj bieżącą turę i wyślij to teraz (%1$@). %2$@ dodaje to do kolejki na po turze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interromper: parar o turno atual e enviar isto agora (%1$@). %2$@ coloca na fila para depois do turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прервать: остановить текущий ход и отправить сейчас (%1$@). %2$@ ставит в очередь на после хода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Böl: geçerli turu durdur ve bunu şimdi gönder (%1$@). %2$@ turdan sonrası için sıraya alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перервати: зупинити поточний хід і надіслати зараз (%1$@). %2$@ ставить у чергу на після ходу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ngắt: dừng lượt hiện tại và gửi ngay (%1$@). %2$@ đưa vào hàng đợi sau lượt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打断：停止当前轮次并立即发送（%1$@）。%2$@ 会将其排到本轮之后。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打斷：停止目前的回合並立即傳送（%1$@）。%2$@ 會將其排到本回合之後。"
          }
        }
      }
    },
