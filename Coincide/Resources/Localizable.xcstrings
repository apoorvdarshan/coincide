          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Для входа, CAPTCHA и кодов двухфакторной аутентификации агенты передают управление вам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajanlar oturum açma, CAPTCHA ve iki adımlı kodlar için devralmanızı ister."
