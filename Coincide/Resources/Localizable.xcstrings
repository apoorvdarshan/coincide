    "Copies the master back to this Mac and links the agents to the copy. The file in iCloud Drive stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopiert die Hauptdatei zurück auf diesen Mac und verknüpft die Agenten mit der Kopie. Die Datei in iCloud Drive bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copia el archivo principal de nuevo en este Mac y enlaza los agentes con la copia. El archivo de iCloud Drive se conserva."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copia el archivo principal de vuelta en esta Mac y enlaza los agentes con la copia. El archivo de iCloud Drive se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recopie le fichier principal sur ce Mac et lie les agents à la copie. Le fichier dans iCloud Drive est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मास्टर फ़ाइल को वापस इस Mac पर कॉपी करता है और एजेंट को उस कॉपी से लिंक करता है। iCloud Drive में मौजूद फ़ाइल बनी रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menyalin berkas utama kembali ke Mac ini dan menautkan agen ke salinan tersebut. Berkas di iCloud Drive tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copia di nuovo il file principale su questo Mac e collega gli agenti alla copia. Il file in iCloud Drive rimane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "マスターファイルをこの Mac にコピーし直し、エージェントをそのコピーにリンクします。iCloud Drive 上のファイルは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "마스터 파일을 이 Mac으로 다시 복사하고 에이전트를 그 사본에 링크합니다. iCloud Drive의 파일은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopieert het hoofdbestand terug naar deze Mac en koppelt de agents aan de kopie. Het bestand in iCloud Drive blijft staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopiuje plik główny z powrotem na ten Mac i dowiązuje agentów do kopii. Plik w iCloud Drive pozostaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copia o arquivo principal de volta para este Mac e vincula os agentes à cópia. O arquivo no iCloud Drive permanece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Копирует основной файл обратно на этот Mac и связывает агентов с копией. Файл в iCloud Drive остаётся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ana dosyayı bu Mac'e geri kopyalar ve ajanları kopyaya bağlar. iCloud Drive'daki dosya kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Копіює основний файл назад на цей Mac і пов’язує агентів із копією. Файл в iCloud Drive залишається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sao chép tệp chính trở lại máy Mac này và liên kết các tác nhân tới bản sao đó. Tệp trong iCloud Drive vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
