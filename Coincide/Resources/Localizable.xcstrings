        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eles continuam trabalhando depois que o Coincide é encerrado. O host de agentes fecha quando não há mais nada rodando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
