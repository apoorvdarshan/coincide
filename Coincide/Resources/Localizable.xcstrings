    "System follows your region. International uses 1,234,567.89." : {
      "comment" : "Number format setting caption. System and International refer to the option names; keep the literal numeric example unchanged.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„System“ übernimmt das Zahlenformat der Region. „International“ verwendet 1,234,567.89."
