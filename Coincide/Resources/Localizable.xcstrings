    "Git's index is locked. Wait for other Git operations to finish, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Git-Index ist gesperrt. Warte, bis andere Git-Vorgänge abgeschlossen sind, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
