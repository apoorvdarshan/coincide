        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je voor Appshots op beide ⌘-toetsen drukt, start ook het dicteren. Kies een andere toets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Naciśnięcie obu klawiszy ⌘ dla Appshots rozpoczęłoby też dyktowanie. Wybierz inny klawisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pressionar as duas teclas ⌘ para o Appshots também iniciaria o ditado. Escolha outra tecla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нажатие обеих клавиш ⌘ для Appshots также запустит диктовку. Выберите другую клавишу."
