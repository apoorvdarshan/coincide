    "Open the Google sign-in page and finish there. If your browser is on another device, paste the address it ends on here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffne die Google-Anmeldeseite und schließe den Vorgang dort ab. Wenn dein Browser auf einem anderen Gerät läuft, füge hier die Adresse ein, bei der er endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre la página de inicio de sesión de Google y termina allí. Si tu navegador está en otro dispositivo, pega aquí la dirección en la que termina."
          }
        },
        "es-419" : {
          "stringUnit" : {
