        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide запускає власний інструмент командного рядка кожного агента з обліковим записом, у який ви вже ввійшли. Він ніколи не продає й не проксіює токени."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide chạy công cụ dòng lệnh riêng của từng agent với tài khoản bạn đã đăng nhập. Coincide không bao giờ bán hay làm trung gian token."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide 使用你已登录的账户运行每个智能体自己的命令行工具，从不出售或代理 token。"
