    "Preview a Claude Code or Codex conversation before importing. The original file stays unchanged; Coincide keeps a private copy and starts imported threads in approval mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sieh dir ein Gespräch mit Claude Code oder Codex vor dem Import an. Die Originaldatei bleibt unverändert; Coincide speichert eine private Kopie und startet importierte Threads im Genehmigungsmodus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Revisa una conversación de Claude Code o Codex antes de importarla. El archivo original no cambia; Coincide guarda una copia privada e inicia los hilos importados en modo de aprobación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Revisa una conversación de Claude Code o Codex antes de importarla. El archivo original no cambia; Coincide guarda una copia privada e inicia los hilos importados en modo de aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prévisualisez une conversation Claude Code ou Codex avant de l’importer. Le fichier original reste inchangé ; Coincide conserve une copie privée et démarre les fils importés en mode d’approbation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आयात करने से पहले Claude Code या Codex वार्तालाप का पूर्वावलोकन देखें। मूल फ़ाइल अपरिवर्तित रहती है; Coincide एक निजी प्रति रखता है और आयात किए गए थ्रेड अनुमोदन मोड में शुरू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pratinjau percakapan Claude Code atau Codex sebelum mengimpor. File asli tidak berubah; Coincide menyimpan salinan pribadi dan memulai utas impor dalam mode persetujuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Visualizza l’anteprima di una conversazione Claude Code o Codex prima di importarla. Il file originale resta invariato; Coincide conserva una copia privata e avvia le conversazioni importate in modalità approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Claude CodeまたはCodexの会話を読み込む前にプレビューします。元のファイルは変更されません。Coincideは非公開のコピーを保存し、読み込んだスレッドを承認モードで開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "가져오기 전에 Claude Code 또는 Codex 대화를 미리 확인하세요. 원본 파일은 변경되지 않으며, Coincide는 비공개 사본을 보관하고 가져온 스레드를 승인 모드로 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bekijk een Claude Code- of Codex-gesprek voordat je het importeert. Het oorspronkelijke bestand blijft ongewijzigd; Coincide bewaart een privékopie en start geïmporteerde threads in goedkeuringsmodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyświetl podgląd rozmowy Claude Code lub Codex przed importem. Oryginalny plik pozostanie bez zmian; Coincide zachowa prywatną kopię i uruchomi importowane wątki w trybie zatwierdzania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veja uma prévia da conversa do Claude Code ou Codex antes de importar. O arquivo original permanece inalterado; o Coincide mantém uma cópia privada e inicia as conversas importadas no modo de aprovação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Просмотрите беседу Claude Code или Codex перед импортом. Исходный файл не изменится; Coincide сохранит частную копию и запустит импортированные ветки в режиме подтверждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "İçe aktarmadan önce Claude Code veya Codex konuşmasını önizleyin. Özgün dosya değişmez; Coincide özel bir kopya saklar ve içe aktarılan konuşmaları onay modunda başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перегляньте розмову Claude Code або Codex перед імпортом. Початковий файл не зміниться; Coincide збереже приватну копію та запустить імпортовані гілки в режимі підтвердження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Xem trước cuộc trò chuyện Claude Code hoặc Codex trước khi nhập. Tệp gốc không thay đổi; Coincide giữ một bản sao riêng tư và bắt đầu các cuộc trò chuyện đã nhập ở chế độ phê duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "导入前预览 Claude Code 或 Codex 对话。原始文件保持不变；Coincide 会保留私有副本，并以审批模式启动导入的话题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "匯入前預覽 Claude Code 或 Codex 對話。原始檔案保持不變；Coincide 會保留私人副本，並以核准模式啟動匯入的討論串。"
          }
        }
      }
    },
