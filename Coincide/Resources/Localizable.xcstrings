    "Let’s make today count. What’s the one thing you want done?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Machen wir das Beste aus dem Tag. Was ist das eine, das heute erledigt werden soll?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vamos a aprovechar el día. ¿Qué es lo que más quieres dejar hecho?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hagamos que hoy valga la pena. ¿Qué es lo que más quieres terminar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faisons en sorte que cette journée compte. Quelle est la chose que vous voulez accomplir ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "चलिए, आज का दिन कामयाब बनाते हैं। वह एक काम क्या है जो आप पूरा करना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mari buat hari ini berarti. Satu hal apa yang ingin Anda selesaikan?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Facciamo in modo che oggi conti. Qual è l’unica cosa che vuoi portare a termine?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今日を実りある一日にしましょう。一番やり遂げたいことは何ですか？"
          }
        },
