        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berichten die je stuurt terwijl een agent werkt, wachten tot de beurt is afgelopen. Met Command-Return stuur je er in plaats daarvan een naar de huidige beurt."
          }
        },
        "pl" : {
