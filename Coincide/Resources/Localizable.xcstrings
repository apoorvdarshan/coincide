    "When an agent stops at its plan's limit, the thread continues on its own once the limit resets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn ein Agent das Limit seines Tarifs erreicht, wird die Unterhaltung automatisch fortgesetzt, sobald das Limit zurückgesetzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando un agente se detiene al alcanzar el límite de su plan, el hilo continúa automáticamente al restablecerse el límite."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando un agente se detiene al alcanzar el límite de su plan, el hilo continúa automáticamente al restablecerse el límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lorsqu’un agent s’arrête à la limite de son forfait, la conversation reprend automatiquement une fois la limite réinitialisée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब एजेंट अपने प्लान की सीमा पर रुकता है, तो सीमा रीसेट होते ही बातचीत अपने आप जारी होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saat agen berhenti karena batas paketnya, percakapan dilanjutkan secara otomatis setelah batas diatur ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando un agente si ferma al limite del suo piano, la conversazione riprende automaticamente quando il limite viene reimpostato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントがプランの制限に達して停止すると、制限のリセット後にスレッドが自動で再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트가 요금제 한도에 도달해 멈추면 한도가 초기화된 뒤 스레드가 자동으로 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als een agent de limiet van zijn abonnement bereikt, gaat het gesprek automatisch verder zodra de limiet wordt gereset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gdy agent zatrzyma się na limicie swojego planu, wątek jest automatycznie kontynuowany po zresetowaniu limitu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando um agente para no limite do seu plano, a conversa continua automaticamente assim que o limite é redefinido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Когда агент останавливается из-за лимита своего плана, обсуждение автоматически продолжается после сброса лимита."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
