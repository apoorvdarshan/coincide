    "%@’s Keychain key wasn’t available, so nothing was imported. Try again and choose Allow when macOS asks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Schlüsselbund-Schlüssel von %@ war nicht verfügbar, daher wurde nichts importiert. Versuche es erneut und wähle „Erlauben“, wenn macOS fragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clave del llavero de %@ no estaba disponible, así que no se importó nada. Inténtalo de nuevo y elige Permitir cuando macOS pregunte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clave del llavero de %@ no estaba disponible, así que no se importó nada. Inténtalo de nuevo y elige Permitir cuando macOS pregunte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La clé du trousseau de %@ n’était pas disponible, rien n’a donc été importé. Réessayez et choisissez Autoriser lorsque macOS le demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ की कीचेन कुंजी उपलब्ध नहीं थी, इसलिए कुछ भी इम्पोर्ट नहीं हुआ। फिर से कोशिश करें और macOS के पूछने पर अनुमति दें चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kunci Rantai Kunci %@ tidak tersedia, jadi tidak ada yang diimpor. Coba lagi dan pilih Izinkan saat macOS bertanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La chiave del portachiavi di %@ non era disponibile, quindi non è stato importato nulla. Riprova e scegli Consenti quando macOS lo chiede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ のキーチェーン鍵を使用できなかったため、何も読み込まれませんでした。もう一度試し、macOS に確認されたら「許可」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@의 키체인 키를 사용할 수 없어 아무것도 가져오지 못했습니다. 다시 시도하고 macOS가 물으면 허용을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De sleutelhangersleutel van %@ was niet beschikbaar, dus er is niets geïmporteerd. Probeer het opnieuw en kies Sta toe als macOS erom vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klucz przeglądarki %@ z pęku kluczy był niedostępny, więc niczego nie zaimportowano. Spróbuj ponownie i wybierz Pozwól, gdy macOS zapyta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A chave das Chaves do %@ não estava disponível, então nada foi importado. Tente de novo e escolha Permitir quando o macOS perguntar."
          }
