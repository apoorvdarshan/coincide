    "Development builds run agents in the app. Launch with COINCIDE_AGENT_HOST=1 to use the agent host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entwicklungs-Builds führen Agenten in der App aus. Starte mit COINCIDE_AGENT_HOST=1, um den Agent-Host zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
