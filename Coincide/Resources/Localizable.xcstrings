    "Schedules agents create in their thread run without asking. You still see and change them in the thread and in Scheduled Tasks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeitpläne, die Agenten in ihrem Thread erstellen, laufen ohne Nachfrage. Du siehst und änderst sie weiterhin im Thread und unter „Geplante Aufgaben“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las programaciones que los agentes crean en su conversación se ejecutan sin preguntar. Puedes seguir viéndolas y cambiándolas en la conversación y en Tareas programadas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las programaciones que los agentes crean en su conversación se ejecutan sin preguntar. Puedes seguir viéndolas y cambiándolas en la conversación y en Tareas programadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les planifications que les agents créent dans leur discussion s’exécutent sans demander. Vous pouvez toujours les voir et les modifier dans la discussion et dans Tâches planifiées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एजेंट अपने थ्रेड में जो समय-सारणियाँ बनाते हैं, वे बिना पूछे चलती हैं। आप फिर भी उन्हें थ्रेड में और निर्धारित कार्य में देख और बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jadwal yang dibuat agen di utasnya berjalan tanpa bertanya. Anda tetap dapat melihat dan mengubahnya di utas dan di Tugas Terjadwal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le pianificazioni che gli agenti creano nel loro thread vengono eseguite senza chiedere. Puoi comunque vederle e modificarle nel thread e in Attività pianificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントが自分のスレッドで作成したスケジュールは、確認なしで実行されます。スケジュールはスレッドと“スケジュール済みタスク”で引き続き確認・変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트가 자신의 스레드에서 만든 일정은 묻지 않고 실행됩니다. 스레드와 ‘예약 작업’에서 계속 확인하고 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schema's die agents in hun thread maken, worden zonder te vragen uitgevoerd. Je kunt ze nog steeds bekijken en wijzigen in de thread en in Geplande taken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Harmonogramy tworzone przez agentów w ich wątku działają bez pytania. Nadal możesz je zobaczyć i zmienić w wątku oraz w sekcji Zaplanowane zadania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os agendamentos que os agentes criam na própria conversa são executados sem perguntar. Você ainda pode vê-los e alterá-los na conversa e em Tarefas agendadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Расписания, которые агенты создают в своём чате, запускаются без запроса. Вы по-прежнему видите их и можете изменить в чате и в разделе «Запланированные задачи»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajanların kendi sohbetlerinde oluşturduğu zamanlamalar sormadan çalışır. Bunları yine sohbette ve Zamanlanmış Görevler'de görüp değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Розклади, які агенти створюють у своєму чаті, запускаються без запиту. Ви й надалі бачите їх і можете змінити в чаті та в розділі «Заплановані завдання»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lịch do agent tạo trong luồng của mình sẽ chạy mà không cần hỏi. Bạn vẫn xem và thay đổi chúng trong luồng và trong Tác vụ đã lên lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "智能体在其对话中创建的计划会直接运行，无需询问。你仍可在对话和“计划任务”中查看和更改它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "代理程式在其對話中建立的排程會直接執行，無需詢問。你仍可在對話和「排程任務」中查看和更改它們。"
          }
        }
      }
    },
