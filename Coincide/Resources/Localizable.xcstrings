    "xAI shows a team’s balance only through its Management API, which needs a management key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI zeigt das Guthaben eines Teams nur über seine Management API an, die einen Management-Schlüssel erfordert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI solo muestra el saldo de un equipo a través de su Management API, que requiere una clave de gestión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI solo muestra el saldo de un equipo a través de su Management API, que requiere una clave de administración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI n’affiche le solde d’une équipe que via sa Management API, qui nécessite une clé de gestion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI किसी टीम का बैलेंस सिर्फ़ अपने Management API से दिखाता है, जिसके लिए प्रबंधन कुंजी चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI hanya menampilkan saldo tim melalui Management API-nya, yang memerlukan kunci manajemen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI mostra il saldo di un team solo tramite la sua Management API, che richiede una chiave di gestione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAIはチームの残高をManagement APIでのみ公開しており、管理キーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI는 팀의 잔액을 Management API로만 제공하며, 이를 위해 관리 키가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "xAI toont het saldo van een team alleen via zijn Management API, waarvoor een beheersleutel nodig is."
          }
