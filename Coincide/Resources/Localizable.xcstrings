    "Thread history is kept. Antigravity asks you to sign in again before its next turn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Thread-Verlauf bleibt erhalten. Antigravity bittet dich vor seinem nächsten Durchgang, dich erneut anzumelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conserva el historial de conversaciones. Antigravity te pedirá que vuelvas a iniciar sesión antes de su próximo turno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conserva el historial de conversaciones. Antigravity te pedirá que vuelvas a iniciar sesión antes de su próximo turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'historique des discussions est conservé. Antigravity vous demandera de vous reconnecter avant son prochain tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "थ्रेड का इतिहास बना रहता है। अगले टर्न से पहले Antigravity आपसे फिर से साइन इन करने को कहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riwayat utas tetap disimpan. Antigravity akan meminta Anda masuk lagi sebelum giliran berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La cronologia dei thread viene mantenuta. Antigravity ti chiederà di accedere di nuovo prima del prossimo turno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スレッドの履歴は保持されます。Antigravityは次のターンの前に再度サインインを求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스레드 기록은 유지됩니다. Antigravity는 다음 턴 전에 다시 로그인하도록 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De threadgeschiedenis blijft behouden. Antigravity vraagt je om opnieuw in te loggen vóór de volgende beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Historia wątków zostanie zachowana. Antigravity poprosi o ponowne zalogowanie przed następną turą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O histórico da conversa é mantido. O Antigravity pede que você faça login novamente antes do próximo turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
