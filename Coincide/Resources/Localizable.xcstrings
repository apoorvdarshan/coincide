          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Считывать данные входа Cursor CLI из связки ключей macOS, чтобы показывать месячные лимиты вашего тарифа в поле ввода. macOS может попросить разрешить доступ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Planınızın aylık limitlerini mesaj kutusunda göstermek için Cursor CLI girişinizi macOS Anahtar Zinciri'nden oku. macOS erişime izin vermenizi isteyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
