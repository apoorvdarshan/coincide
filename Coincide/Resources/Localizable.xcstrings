    "Add as many accounts as you like and pick one per thread in the model picker. API keys are kept in the macOS Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge beliebig viele Accounts hinzu und wähle in der Modellauswahl einen pro Thread. API-Schlüssel werden im macOS-Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade tantas cuentas como quieras y elige una por conversación en el selector de modelos. Las claves de API se guardan en el llavero de macOS."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
