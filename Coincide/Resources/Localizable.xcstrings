    "%@ normally types a character, such as a non-breaking space for ⌥Space. In Coincide’s windows it starts dictation instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ gibt normalerweise ein Zeichen ein, etwa ein geschütztes Leerzeichen bei ⌥Leertaste. In den Fenstern von Coincide startet es stattdessen das Diktieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ normalmente escribe un carácter, como un espacio de no separación con ⌥Espacio. En las ventanas de Coincide, en cambio, inicia el dictado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ normalmente escribe un carácter, como un espacio de no separación con ⌥Espacio. En las ventanas de Coincide, en cambio, inicia el dictado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ saisit normalement un caractère, comme une espace insécable pour ⌥Espace. Dans les fenêtres de Coincide, il lance plutôt la dictée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ आम तौर पर कोई अक्षर टाइप करता है, जैसे ⌥स्पेस से नॉन-ब्रेकिंग स्पेस। Coincide की विंडो में यह इसके बजाय डिक्टेशन शुरू करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ biasanya mengetik karakter, seperti spasi tanpa pemisah untuk ⌥Spasi. Di jendela Coincide, pintasan ini justru memulai dikte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ di solito digita un carattere, ad esempio uno spazio unificatore con ⌥Spazio. Nelle finestre di Coincide avvia invece la dettatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@は通常、文字を入力します（例：⌥Spaceでノーブレークスペース）。Coincideのウインドウでは、代わりに音声入力を開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) 보통 문자를 입력합니다(예: ⌥Space는 줄바꿈 없는 공백). Coincide 윈도우에서는 대신 받아쓰기를 시작합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ typt normaal een teken, zoals een harde spatie bij ⌥Spatie. In de vensters van Coincide start het in plaats daarvan het dicteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ zwykle wpisuje znak, na przykład spację nierozdzielającą dla ⌥Spacja. W oknach Coincide zamiast tego rozpoczyna dyktowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ normalmente digita um caractere, como um espaço não separável com ⌥Espaço. Nas janelas do Coincide, ele inicia o ditado em vez disso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обычно %@ вводит символ, например неразрывный пробел для ⌥Пробел. В окнах Coincide это сочетание запускает диктовку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ normalde bir karakter yazar; örneğin ⌥Boşluk bölünemez boşluk yazar. Coincide pencerelerinde bunun yerine dikteyi başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зазвичай %@ вводить символ, наприклад нерозривний пробіл для ⌥Пробіл. У вікнах Coincide це скорочення запускає диктування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ thường nhập một ký tự, chẳng hạn ⌥Phím cách nhập dấu cách không ngắt. Trong các cửa sổ Coincide, phím tắt này sẽ bắt đầu đọc chính tả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 通常会输入一个字符，例如 ⌥空格键会输入不换行空格。在 Coincide 的窗口中，它会改为开始听写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 通常會輸入一個字元，例如 ⌥空白鍵會輸入不斷行空格。在 Coincide 的視窗中，它會改為開始聽寫。"
          }
        }
      }
    },
