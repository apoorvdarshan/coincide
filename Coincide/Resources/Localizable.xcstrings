        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chi è il bot e come lavora. Il suo agente riceve questo testo all'inizio di ogni sessione; non compare mai nella conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ボットの人物像と働き方です。エージェントは各セッションの開始時にこれを受け取りますが、会話には表示されません。"
