    "Chrome, Safari and Apple Passwords, Firefox, 1Password and Bitwarden exports work. The logins are saved in your Keychain as Coincide saved logins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exporte aus Chrome, Safari und Apple Passwörter, Firefox, 1Password und Bitwarden funktionieren. Die Anmeldungen werden als bei Coincide gesicherte Anmeldungen in deinem Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funcionan las exportaciones de Chrome, Safari y Contraseñas de Apple, Firefox, 1Password y Bitwarden. Los inicios de sesión se guardan en tu llavero como inicios de sesión de Coincide."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funcionan las exportaciones de Chrome, Safari y Contraseñas de Apple, Firefox, 1Password y Bitwarden. Los inicios de sesión se guardan en tu llavero como inicios de sesión de Coincide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les exports de Chrome, Safari et Mots de passe d’Apple, Firefox, 1Password et Bitwarden fonctionnent. Les identifiants sont enregistrés dans votre trousseau comme identifiants Coincide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chrome, Safari और Apple पासवर्ड, Firefox, 1Password और Bitwarden के एक्सपोर्ट काम करते हैं। लॉगिन Coincide में सहेजे गए लॉगिन के रूप में आपके कीचेन में रखे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ekspor dari Chrome, Safari dan Kata Sandi Apple, Firefox, 1Password, serta Bitwarden didukung. Login disimpan di Rantai Kunci sebagai login tersimpan Coincide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funzionano le esportazioni di Chrome, Safari e Password di Apple, Firefox, 1Password e Bitwarden. Gli accessi vengono salvati nel portachiavi come accessi salvati in Coincide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chrome、Safari と Apple パスワード、Firefox、1Password、Bitwarden の書き出しに対応しています。ログインは Coincide に保存したログインとしてキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chrome, Safari 및 Apple 암호, Firefox, 1Password, Bitwarden 내보내기를 지원합니다. 로그인은 Coincide 저장 로그인으로 키체인에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exports van Chrome, Safari en Apple Wachtwoorden, Firefox, 1Password en Bitwarden werken. De aanmeldingen worden in je sleutelhanger bewaard als in Coincide bewaarde aanmeldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Działają eksporty z Chrome, Safari i Haseł Apple, Firefoksa, 1Password i Bitwarden. Loginy są zapisywane w pęku kluczy jako loginy zapisane w Coincide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funcionam exportações do Chrome, Safari e Senhas da Apple, Firefox, 1Password e Bitwarden. Os logins são salvos nas suas Chaves como logins salvos no Coincide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Поддерживаются экспорты Chrome, Safari и Паролей Apple, Firefox, 1Password и Bitwarden. Данные входа сохраняются в связке ключей как входы, сохранённые в Coincide."
          }
        },
        "tr" : {
          "stringUnit" : {
