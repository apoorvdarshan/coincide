    "Keep it plugged in: on battery the Mac runs until the battery is empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lass ihn am Netzteil: Mit Batterie läuft der Mac, bis sie leer ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenlo enchufado: con batería, el Mac funciona hasta que se agota."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenlo enchufado: con batería, el Mac funciona hasta que se agota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laissez-le branché : sur batterie, le Mac fonctionne jusqu’à ce qu’elle soit vide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इसे प्लग इन रखें: बैटरी पर Mac तब तक चलता है जब तक बैटरी खत्म न हो जाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Biarkan tercolok: dengan baterai, Mac berjalan sampai baterai habis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tienilo collegato: a batteria il Mac funziona finché non si scarica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "電源につないでおいてください。バッテリーでは空になるまで動き続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "전원에 연결해 두세요. 배터리로는 다 떨어질 때까지 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd hem aan de lader: op de batterij draait de Mac tot die leeg is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trzymaj go podłączonego: na baterii Mac działa, aż się rozładuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deixe na tomada: na bateria, o Mac funciona até ela acabar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
