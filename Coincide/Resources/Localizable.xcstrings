    "Keyboard or mouse input can’t keep an external display awake: it goes dark again within two seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tastatur oder Maus können ein externes Display nicht wach halten: Es wird innerhalb von zwei Sekunden wieder dunkel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El teclado o el ratón no pueden mantener activa una pantalla externa: se apaga de nuevo en dos segundos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El teclado o el mouse no pueden mantener activa una pantalla externa: se apaga de nuevo en dos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le clavier ou la souris ne peuvent pas garder un écran externe allumé : il s’éteint à nouveau en deux secondes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कीबोर्ड या माउस किसी बाहरी डिस्प्ले को चालू नहीं रख सकते: वह दो सेकंड के अंदर फिर से बंद हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Papan ketik atau tetikus tidak dapat membuat layar eksternal tetap menyala: layar akan gelap lagi dalam dua detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tastiera o mouse non possono tenere acceso uno schermo esterno: si spegne di nuovo entro due secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "キーボードやマウスで外部ディスプレイをオンのままにはできません。2秒以内に再び暗くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "키보드나 마우스로 외장 디스플레이를 켜 둘 수 없습니다. 2초 안에 다시 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toetsenbord of muis kunnen een extern scherm niet wakker houden: het wordt binnen twee seconden weer donker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klawiatura ani mysz nie utrzymają włączonego zewnętrznego ekranu: zgaśnie ponownie w ciągu dwóch sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teclado ou mouse não conseguem manter uma tela externa acesa: ela se apaga de novo em dois segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Клавиатура или мышь не смогут держать внешний дисплей включённым: он снова погаснет в течение двух секунд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klavye veya fare harici bir ekranı açık tutamaz: iki saniye içinde yeniden kararır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Клавіатура чи миша не втримають зовнішній дисплей увімкненим: він знову згасне протягом двох секунд."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bàn phím hoặc chuột không thể giữ màn hình ngoài sáng: nó sẽ tối lại trong vòng hai giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "键盘或鼠标无法让外接显示器保持点亮：它会在两秒内再次变暗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "鍵盤或滑鼠無法讓外接顯示器保持亮著：它會在兩秒內再次變暗。"
          }
        }
      }
    },
