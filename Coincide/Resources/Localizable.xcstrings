    "Kind, reassuring and never rushed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Freundlich, beruhigend und nie in Eile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Amable, tranquilizador y nunca con prisas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Amable, tranquilizador y nunca apurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bienveillant, rassurant et jamais pressé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दयालु, तसल्ली देने वाला और कभी जल्दबाज़ी नहीं करता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ramah, menenangkan, dan tidak pernah terburu-buru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premuroso, rassicurante e mai frettoloso."
          }
        },
        "ja" : {
          "stringUnit" : {
