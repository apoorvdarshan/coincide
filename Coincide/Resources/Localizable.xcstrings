          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ から %1$@ のサインインを読み込み、ページを再読み込みしました。まだサインインを求められる場合は、少し待ってからもう一度読み込んでください。"
