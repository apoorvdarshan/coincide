    "Messages sent while an agent works wait until its turn ends. Command-Return sends one into the current turn instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nachrichten, die du sendest, während ein Agent arbeitet, warten, bis sein Durchgang endet. Mit Befehl-Zeilenschalter wird eine stattdessen in den laufenden Durchgang gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes enviados mientras un agente trabaja esperan a que termine su turno. Comando-Retorno envía uno al turno actual."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes que envías mientras un agente trabaja esperan a que termine su turno. En su lugar, Comando-Retorno envía uno al turno actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les messages envoyés pendant qu'un agent travaille attendent la fin de son tour. Commande-Retour en envoie un dans le tour en cours à la place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एजेंट के काम करते समय भेजे गए संदेश उसका टर्न खत्म होने तक इंतज़ार करते हैं। इसके बजाय Command-Return संदेश को मौजूदा टर्न में भेजता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pesan yang dikirim saat agen bekerja menunggu hingga gilirannya berakhir. Command-Return mengirim pesan ke giliran saat ini sebagai gantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I messaggi inviati mentre un agente lavora attendono la fine del suo turno. Comando-Invio invece ne invia uno nel turno corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
