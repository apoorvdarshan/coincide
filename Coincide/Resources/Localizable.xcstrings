    "Lets this thread's agent read and control its preview through a local shell connection. Turns off when Coincide quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaubt dem Agenten dieses Threads, seine Vorschau über eine lokale Shell-Verbindung zu lesen und zu steuern. Wird beim Beenden von Coincide ausgeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que el agente de este hilo lea y controle su vista previa mediante una conexión de shell local. Se desactiva al salir de Coincide."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que el agente de este hilo lea y controle su vista previa mediante una conexión de shell local. Se desactiva al salir de Coincide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à l’agent de ce fil de lire et de contrôler son aperçu via une connexion shell locale. Se désactive à la fermeture de Coincide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस थ्रेड के एजेंट को स्थानीय शेल कनेक्शन से अपना प्रीव्यू पढ़ने और नियंत्रित करने देता है। Coincide बंद करने पर यह बंद हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengizinkan agen utas ini membaca dan mengontrol pratinjaunya melalui koneksi shell lokal. Dinonaktifkan saat Coincide ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consente all’agente di questa conversazione di leggere e controllare la propria anteprima tramite una connessione shell locale. Si disattiva quando esci da Coincide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このスレッドのエージェントがローカルシェル接続を通じてプレビューを読み取り、操作できるようにします。Coincideを終了すると無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 스레드의 에이전트가 로컬 셸 연결로 미리보기를 읽고 제어할 수 있게 합니다. Coincide를 종료하면 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laat de agent van dit gesprek de voorvertoning lezen en bedienen via een lokale shellverbinding. Wordt uitgeschakeld wanneer Coincide sluit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pozwala agentowi tego wątku odczytywać i kontrolować podgląd przez lokalne połączenie powłoki. Wyłącza się po zamknięciu Coincide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que o agente desta conversa leia e controle a prévia por uma conexão de shell local. É desativado ao sair do Coincide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Позволяет агенту этого диалога читать предпросмотр и управлять им через локальное подключение оболочки. Отключается при выходе из Coincide."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bu konuşmanın ajanının yerel bir kabuk bağlantısıyla önizlemeyi okumasına ve denetlemesine izin verir. Coincide kapatıldığında kapanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дозволяє агенту цього діалогу читати перегляд і керувати ним через локальне з’єднання оболонки. Вимикається після виходу з Coincide."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cho phép tác tử của cuộc trò chuyện này đọc và điều khiển bản xem trước qua kết nối shell cục bộ. Tắt khi thoát Coincide."
          }
        },
        "zh-Hans" : {
