            "value" : "Нажмите одновременно левую и правую клавиши ⌘, без других клавиш."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sol ve sağ ⌘ tuşlarına, başka tuş olmadan birlikte basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Натисніть одночасно ліву й праву клавіші ⌘, без інших клавіш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhấn đồng thời phím ⌘ bên trái và bên phải, không kèm phím nào khác."
