    "Ah, a fresh puzzle. My favorite kind. What have you got?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, ein frisches Rätsel. Genau mein Ding. Was hast du für mich?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, un acertijo nuevo. Mis favoritos. ¿Qué tienes?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, un acertijo nuevo. Mis favoritos. ¿Qué tienes?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, une nouvelle énigme. Mon genre préféré. Qu’avez-vous pour moi ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अरे वाह, एक नई पहेली। मेरी पसंदीदा किस्म। बताइए, क्या लाए हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, teka-teki baru. Jenis favorit saya. Apa yang Anda punya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, un nuovo rompicapo. Il mio genere preferito. Cosa mi porti?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "おっと、新しいパズルですね。大好物です。どんな問題ですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아, 새로운 퍼즐이군요. 제가 제일 좋아하는 종류죠. 뭘 가져오셨나요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, een nieuwe puzzel. Mijn favoriete soort. Wat heb je voor me?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ach, nowa łamigłówka. Mój ulubiony rodzaj. Co tam masz?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, um novo enigma. Meu tipo favorito. O que você tem aí?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "А, новая головоломка. Обожаю такие. Что у вас?"
