          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "봇이 누구이며 어떻게 일하는지 설명합니다. 에이전트는 각 세션을 시작할 때 이 내용을 받으며, 대화에는 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie de bot is en hoe hij werkt. Zijn agent krijgt dit aan het begin van elke sessie; het verschijnt nooit in het gesprek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kim jest bot i jak pracuje. Jego agent otrzymuje ten tekst na początku każdej sesji; nigdy nie pojawia się on w rozmowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
