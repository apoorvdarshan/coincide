    "Bring cookies and sign-ins, history and bookmarks from Safari, Chrome, Firefox and others. Nothing leaves this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Übernimm Cookies und Anmeldungen, Verlauf und Lesezeichen aus Safari, Chrome, Firefox und anderen. Nichts verlässt diesen Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trae cookies e inicios de sesión, historial y marcadores de Safari, Chrome, Firefox y otros. Nada sale de este Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trae cookies e inicios de sesión, historial y marcadores de Safari, Chrome, Firefox y otros. Nada sale de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Récupérez cookies et connexions, historique et signets de Safari, Chrome, Firefox et d’autres. Rien ne quitte ce Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari, Chrome, Firefox और दूसरे ब्राउज़र से कुकीज़ और साइन-इन, इतिहास और बुकमार्क लाएँ। कुछ भी इस Mac से बाहर नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
