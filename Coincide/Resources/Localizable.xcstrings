        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ah, yeni bir bulmaca. En sevdiğim türden. Elinizde ne var?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "О, свіжа головоломка. Обожнюю такі. Що у вас?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À, một câu đố mới toanh. Đúng loại mình thích nhất. Bạn có gì nào?"
