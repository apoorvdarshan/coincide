          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "割り込み：現在のターンに送信（%1$@）。%2$@でターンの終了後に送信するようキューに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "개입: 현재 턴에 보내기(%1$@). %2$@을(를) 누르면 턴이 끝난 후 보내도록 대기열에 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bijsturen: stuur naar de huidige beurt (%1$@). %2$@ zet het in de wachtrij voor na de beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokieruj: wyślij do bieżącej tury (%1$@). %2$@ dodaje ją do kolejki na czas po turze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Direcionar: enviar para o turno atual (%1$@). %2$@ a põe na fila para depois do turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Направить: отправить в текущий ход (%1$@). %2$@ ставит сообщение в очередь до завершения хода."
