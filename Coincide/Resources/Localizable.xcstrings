    "Signing in from another device? After Google sign-in, paste the address its browser ends on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meldest du dich auf einem anderen Gerät an? Füge nach der Google-Anmeldung die Adresse ein, bei der dessen Browser endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Inicias sesión desde otro dispositivo? Después de iniciar sesión en Google, pega la dirección en la que termina su navegador."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Inicias sesión desde otro dispositivo? Después de iniciar sesión con Google, pega la dirección en la que termina su navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous vous connectez depuis un autre appareil ? Après la connexion Google, collez l'adresse sur laquelle son navigateur s'arrête."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी दूसरे डिवाइस से साइन इन कर रहे हैं? Google साइन इन के बाद, उस डिवाइस के ब्राउज़र में आखिर में खुला पता पेस्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masuk dari perangkat lain? Setelah masuk ke Google, tempel alamat terakhir di browser perangkat tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accedi da un altro dispositivo? Dopo l'accesso a Google, incolla l'indirizzo della pagina finale del suo browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別のデバイスからサインインしていますか？Googleでサインインしたら、そのブラウザで最後に表示されたアドレスをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다른 기기에서 로그인하고 있습니까? Google 로그인 후 해당 브라우저에 마지막으로 표시되는 주소를 붙여넣으십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Log je in vanaf een ander apparaat? Plak na het inloggen bij Google het adres waarop de browser daar eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Logujesz się z innego urządzenia? Po zalogowaniu w Google wklej adres, na którym zatrzyma się jego przeglądarka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fazendo login em outro dispositivo? Após o login do Google, cole o endereço em que o navegador dele termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Входите с другого устройства? После входа через Google вставьте адрес, на котором остановился его браузер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Başka bir aygıttan mı giriş yapıyorsunuz? Google girişinden sonra o aygıtın tarayıcısının en son açtığı adresi yapıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Входите з іншого пристрою? Після входу в Google вставте адресу, на якій зупинився його браузер."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đăng nhập từ thiết bị khác? Sau khi đăng nhập Google, hãy dán địa chỉ cuối cùng mà trình duyệt trên thiết bị đó hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "要从另一台设备登录？完成 Google 登录后，粘贴该设备浏览器最终停留的网址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "要從其他裝置登入嗎？完成 Google 登入後，請貼上該裝置瀏覽器最後停留頁面的網址。"
          }
        }
      }
    },
