    "Capture the frontmost window of the app you’re using and attach it to a chat in Coincide, ready for your question." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nimm das vorderste Fenster der App auf, die du gerade verwendest, und hänge es an einen Chat in Coincide an – bereit für deine Frage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Captura la ventana en primer plano de la app que estás usando y adjúntala a un chat en Coincide, lista para tu pregunta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Captura la ventana en primer plano de la app que estás usando y adjúntala a un chat en Coincide, lista para tu pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Capturez la fenêtre au premier plan de l’app que vous utilisez et joignez-la à une discussion dans Coincide, prête pour votre question."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आप जिस ऐप का इस्तेमाल कर रहे हैं, उसकी सबसे आगे वाली विंडो कैप्चर करें और उसे Coincide की किसी चैट में जोड़ें, ताकि आप तुरंत अपना सवाल पूछ सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tangkap jendela paling depan dari app yang sedang Anda gunakan dan lampirkan ke obrolan di Coincide, siap untuk pertanyaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acquisisci la finestra in primo piano dell’app che stai usando e allegala a una chat in Coincide, pronta per la tua domanda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用中のアプリの最前面のウインドウをキャプチャしてCoincideのチャットに添付し、すぐに質問できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사용 중인 앱의 맨 앞 윈도우를 캡처하여 Coincide의 채팅에 첨부하므로 바로 질문할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leg het voorste venster vast van de app die je gebruikt en voeg het toe aan een chat in Coincide, klaar voor je vraag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przechwyć okno na pierwszym planie w aplikacji, której używasz, i dołącz je do czatu w Coincide, aby od razu zadać pytanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Capture a janela em primeiro plano do app que você está usando e anexe-a a um chat no Coincide, pronta para sua pergunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Снимите окно на переднем плане приложения, которым вы пользуетесь, и прикрепите его к чату в Coincide, чтобы сразу задать вопрос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kullandığınız uygulamanın ön plandaki penceresini yakalayın ve sorunuza hazır şekilde Coincide’da bir sohbete ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зніміть вікно на передньому плані програми, якою ви користуєтеся, і прикріпіть його до чату в Coincide, щоб одразу поставити запитання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chụp cửa sổ phía trước của ứng dụng bạn đang dùng và đính kèm vào một cuộc trò chuyện trong Coincide, sẵn sàng cho câu hỏi của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "捕捉你正在使用的 App 的最前方窗口，并将其附加到 Coincide 的聊天中，方便你直接提问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "擷取你正在使用之 App 的最前方視窗，並附加到 Coincide 的聊天中，方便你直接提問。"
          }
        }
      }
    },
