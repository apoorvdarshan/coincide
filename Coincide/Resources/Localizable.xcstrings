    "Who the bot is and how it works. Its agent gets this at the start of each session; it never shows in the conversation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wer der Bot ist und wie er arbeitet. Sein Agent erhält dies zu Beginn jeder Sitzung; es erscheint nie im Gespräch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quién es el bot y cómo trabaja. Su agente lo recibe al inicio de cada sesión; nunca aparece en la conversación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quién es el bot y cómo trabaja. Su agente lo recibe al inicio de cada sesión; nunca aparece en la conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
