    "Thread history is kept. Antigravity asks you to sign in again before its next turn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Thread-Verlauf bleibt erhalten. Antigravity bittet dich vor seinem nächsten Durchgang, dich erneut anzumelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conserva el historial de conversaciones. Antigravity te pedirá que vuelvas a iniciar sesión antes de su próximo turno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
