    "Steer: send into the current turn (%@). %@ queues it for after the turn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lenken: in den aktuellen Durchgang senden (%1$@). %2$@ reiht sie für nach dem Durchgang ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Steer: send into the current turn (%1$@). %2$@ queues it for after the turn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dirigir: enviar al turno actual (%1$@). %2$@ lo pone en cola para después del turno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guiar: enviar al turno actual (%1$@). %2$@ lo pone en cola para después del turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Orienter : envoyer dans le tour en cours (%1$@). %2$@ le met en file d'attente jusqu'à la fin du tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "दिशा दें: मौजूदा टर्न में भेजें (%1$@)। %2$@ इसे टर्न के बाद के लिए कतार में डालता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arahkan: kirim ke giliran saat ini (%1$@). %2$@ memasukkannya ke antrean untuk setelah giliran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indirizza: invia nel turno corrente (%1$@). %2$@ lo mette in coda per dopo il turno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "割り込み：現在のターンに送信（%1$@）。%2$@でターンの終了後に送信するようキューに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "개입: 현재 턴에 보내기(%1$@). %2$@을(를) 누르면 턴이 끝난 후 보내도록 대기열에 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bijsturen: stuur naar de huidige beurt (%1$@). %2$@ zet het in de wachtrij voor na de beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokieruj: wyślij do bieżącej tury (%1$@). %2$@ dodaje ją do kolejki na czas po turze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Direcionar: enviar para o turno atual (%1$@). %2$@ a põe na fila para depois do turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Направить: отправить в текущий ход (%1$@). %2$@ ставит сообщение в очередь до завершения хода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yönlendir: geçerli tura gönder (%1$@). %2$@ ise turdan sonrası için sıraya alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скерування: надіслати в поточний хід (%1$@). %2$@ ставить його в чергу до завершення ходу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Định hướng: gửi vào lượt hiện tại (%1$@). %2$@ sẽ xếp tin nhắn vào hàng đợi cho sau lượt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "引导：发送到当前轮次（%1$@）。%2$@ 则会将其排队，待本轮结束后发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "引導：送入目前的回合（%1$@）。%2$@ 則會將訊息排入佇列，待回合結束後傳送。"
          }
        }
      }
    },
