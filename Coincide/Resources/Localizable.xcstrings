    "Parts of a branch name can’t start with “.” or end with “.lock”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teile eines Branch-Namens dürfen nicht mit „.“ beginnen oder auf „.lock“ enden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las partes de un nombre de rama no pueden empezar por “.” ni terminar en “.lock”."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las partes de un nombre de rama no pueden empezar con “.” ni terminar en “.lock”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les parties d'un nom de branche ne peuvent pas commencer par « . » ni se terminer par « .lock »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ब्रांच के नाम के हिस्से “.” से शुरू या “.lock” पर खत्म नहीं हो सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bagian nama branch tidak boleh diawali dengan “.” atau diakhiri dengan “.lock”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le parti del nome di un branch non possono iniziare con “.” o terminare con “.lock”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ブランチ名の各部分は、“.”で始めたり“.lock”で終わったりすることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "브랜치 이름의 각 부분은 “.”로 시작하거나 “.lock”으로 끝날 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Delen van een branchnaam mogen niet beginnen met “.” of eindigen op “.lock”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Części nazwy gałęzi nie mogą zaczynać się od „.” ani kończyć na „.lock”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Partes de um nome de branch não podem começar com “.” nem terminar com “.lock”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Части имени ветки не могут начинаться с «.» или заканчиваться на «.lock»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dal adının bölümleri “.” ile başlayamaz veya “.lock” ile bitemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Частини назви гілки не можуть починатися з «.» або закінчуватися на «.lock»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Các phần của tên nhánh không được bắt đầu bằng “.” hoặc kết thúc bằng “.lock”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "分支名称的各部分不能以“.”开头或以“.lock”结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "分支名稱的各部分不能以「.」開頭，或以「.lock」結尾。"
          }
        }
      }
    },
