        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "안녕하십니까. 무엇을 도와드릴까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
