        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los agentes te piden que tomes el control para inicios de sesión, CAPTCHA y códigos de verificación en dos pasos."
          }
        },
        "fr" : {
          "stringUnit" : {
