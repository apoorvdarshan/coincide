        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नए थ्रेड इसी से शुरू होते हैं; हर थ्रेड अपनी पसंद रखता है, जो उसके कंपोज़र में सेट होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utas baru dimulai dengan ini; setiap utas menyimpan pilihannya sendiri, yang diatur di penyusunnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I nuovi thread partono con questa scelta; ogni thread mantiene la propria, impostata nel suo compositore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新しいスレッドはこの設定で始まります。各スレッドは、入力欄で選んだ独自の設定を保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "새 스레드는 이 설정으로 시작합니다. 각 스레드는 작성기에서 정한 자체 선택을 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nieuwe threads beginnen hiermee; elke thread houdt zijn eigen keuze, ingesteld in zijn invoerveld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nowe wątki zaczynają z tym ustawieniem; każdy wątek zachowuje własny wybór, ustawiany w jego edytorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Novas conversas começam com isso; cada conversa mantém sua própria escolha, definida no seu editor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Новые треды начинаются с этого; каждый тред хранит свой выбор, заданный в его поле ввода."
