    "Speech recognition isn’t allowed. Turn it on in Settings › Privacy & Security › Speech Recognition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Spracherkennung ist nicht erlaubt. Aktiviere sie unter „Systemeinstellungen“ › „Datenschutz & Sicherheit“ › „Spracherkennung“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El reconocimiento de voz no está permitido. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Reconocimiento de voz."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El reconocimiento de voz no está permitido. Actívalo en Configuración del Sistema › Privacidad y seguridad › Reconocimiento de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La reconnaissance vocale n’est pas autorisée. Activez-la dans Réglages Système › Confidentialité et sécurité › Reconnaissance vocale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्पीच रिकग्निशन की अनुमति नहीं है। इसे सिस्टम सेटिंग्ज़ › गोपनीयता और सुरक्षा › स्पीच रिकग्निशन में चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pengenalan ucapan tidak diizinkan. Nyalakan di Pengaturan Sistem › Privasi & Keamanan › Pengenalan Ucapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il riconoscimento vocale non è consentito. Attivalo in Impostazioni › Privacy e sicurezza › Riconoscimento vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音声認識が許可されていません。設定 › プライバシーとセキュリティ › 音声認識でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "음성 인식이 허용되지 않았습니다. 설정 › 개인정보 보호 및 보안 › 음성 인식에서 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spraakherkenning is niet toegestaan. Schakel dit in via Instellingen › Privacy en beveiliging › Spraakherkenning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozpoznawanie mowy jest niedozwolone. Włącz je w Ustawienia › Prywatność i ochrona › Rozpoznawanie mowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O reconhecimento de fala não é permitido. Ative-o em Ajustes › Privacidade e Segurança › Reconhecimento de Fala."
