          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@: de sleutelhangersleutel van de browser was niet beschikbaar, dus er is niets geïmporteerd. Probeer het opnieuw en kies Sta toe."
