        }
      }
    },
    "Coincide makes a new certificate and forgets every paired device. Each one has to pair again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide erstellt ein neues Zertifikat und vergisst alle gekoppelten Geräte. Jedes muss erneut gekoppelt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide crea un certificado nuevo y olvida todos los dispositivos enlazados. Cada uno tendrá que volver a enlazarse."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide crea un certificado nuevo y olvida todos los dispositivos enlazados. Cada uno tendrá que volver a enlazarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide crée un nouveau certificat et oublie tous les appareils jumelés. Chacun devra être jumelé à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide नया सर्टिफ़िकेट बनाएगा और सभी पेयर किए गए डिवाइस भूल जाएगा। हर डिवाइस को फिर से पेयर करना होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide membuat sertifikat baru dan melupakan semua perangkat yang dipasangkan. Setiap perangkat harus dipasangkan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide crea un nuovo certificato e dimentica tutti i dispositivi abbinati. Ognuno dovrà essere abbinato di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincideは新しい証明書を作成し、ペアリング済みのすべてのデバイスの登録を解除します。各デバイスでもう一度ペアリングする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide가 새 인증서를 만들고 페어링된 모든 기기를 삭제합니다. 각 기기를 다시 페어링해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide maakt een nieuw certificaat en vergeet alle gekoppelde apparaten. Elk apparaat moet opnieuw koppelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide utworzy nowy certyfikat i zapomni wszystkie sparowane urządzenia. Każde trzeba będzie sparować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Coincide cria um novo certificado e esquece todos os dispositivos emparelhados. Cada um precisará ser emparelhado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide создаст новый сертификат и забудет все привязанные устройства. Каждое придётся привязать заново."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide yeni bir sertifika oluşturur ve eşleştirilmiş tüm aygıtları unutur. Her birinin yeniden eşleştirilmesi gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide створить новий сертифікат і забуде всі прив’язані пристрої. Кожен доведеться прив’язати знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide sẽ tạo chứng chỉ mới và quên mọi thiết bị đã ghép đôi. Mỗi thiết bị phải ghép đôi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide 会创建新证书并忘记所有已配对的设备。每台设备都需要重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide 會建立新的憑證，並忘記所有已配對的裝置。每部裝置都需要重新配對。"
          }
        }
      }
    },
    "Coincide moves each file it replaces to a backup named like CLAUDE.md.coincide-backup-<date> beside it, and never deletes text. Links to other files are left alone unless you choose to replace them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide verschiebt jede ersetzte Datei als Sicherung mit einem Namen wie CLAUDE.md.coincide-backup-<date> daneben und löscht niemals Text. Verknüpfungen mit anderen Dateien bleiben unverändert, es sei denn, Sie wählen, sie zu ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide mueve cada archivo que sustituye a una copia de seguridad con un nombre como CLAUDE.md.coincide-backup-<date> junto al original, y nunca borra texto. Los enlaces a otros archivos no se tocan, a menos que elijas sustituirlos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide mueve cada archivo que reemplaza a un respaldo con un nombre como CLAUDE.md.coincide-backup-<date> junto al original, y nunca borra texto. Los enlaces a otros archivos no se tocan, a menos que elijas reemplazarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide déplace chaque fichier remplacé vers une sauvegarde nommée comme CLAUDE.md.coincide-backup-<date> à côté de l’original, et ne supprime jamais de texte. Les liens vers d’autres fichiers sont laissés intacts, sauf si vous choisissez de les remplacer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide जिस भी फ़ाइल को बदलता है, उसे उसी जगह CLAUDE.md.coincide-backup-<date> जैसे नाम वाले बैकअप में ले जाता है, और टेक्स्ट कभी नहीं हटाता। अन्य फ़ाइलों के लिंक तब तक वैसे ही रहते हैं जब तक आप उन्हें बदलना न चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide memindahkan setiap berkas yang diganti ke cadangan bernama seperti CLAUDE.md.coincide-backup-<date> di sebelahnya, dan tidak pernah menghapus teks. Tautan ke berkas lain dibiarkan kecuali Anda memilih menggantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide sposta ogni file che sostituisce in un backup con un nome come CLAUDE.md.coincide-backup-<date> accanto all’originale e non elimina mai testo. I collegamenti ad altri file restano invariati, a meno che tu non scelga di sostituirli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide は、置き換える各ファイルを、同じ場所に CLAUDE.md.coincide-backup-<date> のような名前のバックアップとして移動し、テキストを削除することはありません。ほかのファイルへのリンクは、置き換えることを選択しない限りそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide는 대체하는 각 파일을 같은 위치에 CLAUDE.md.coincide-backup-<date>와 같은 이름의 백업으로 이동하며, 텍스트를 삭제하지 않습니다. 다른 파일에 대한 링크는 대체하도록 선택하지 않는 한 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide verplaatst elk bestand dat het vervangt naar een reservekopie met een naam als CLAUDE.md.coincide-backup-<date> ernaast en verwijdert nooit tekst. Links naar andere bestanden blijven ongemoeid, tenzij je ervoor kiest ze te vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide przenosi każdy zastępowany plik do kopii zapasowej o nazwie w stylu CLAUDE.md.coincide-backup-<date>, obok oryginału, i nigdy nie usuwa tekstu. Dowiązania do innych plików pozostają nietknięte, chyba że zdecydujesz się je zastąpić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Coincide move cada arquivo que substitui para um backup com nome como CLAUDE.md.coincide-backup-<date> ao lado do original e nunca apaga texto. Vínculos com outros arquivos são mantidos, a menos que você escolha substituí-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide переносит каждый заменяемый файл в резервную копию с именем вида CLAUDE.md.coincide-backup-<date> рядом с ним и никогда не удаляет текст. Ссылки на другие файлы не затрагиваются, если только вы не решите их заменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide, değiştirdiği her dosyayı yanında CLAUDE.md.coincide-backup-<date> gibi adlandırılmış bir yedeğe taşır ve metni asla silmez. Başka dosyalara giden bağlantılar, değiştirmeyi seçmediğiniz sürece olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide переміщує кожен файл, який замінює, до резервної копії з назвою на кшталт CLAUDE.md.coincide-backup-<date> поруч із ним і ніколи не видаляє текст. Посилання на інші файли не чіпаються, якщо ви не вирішите їх замінити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide chuyển mỗi tệp mà nó thay thế vào một bản sao lưu có tên như CLAUDE.md.coincide-backup-<date> ngay bên cạnh, và không bao giờ xóa văn bản. Các liên kết tới tệp khác được giữ nguyên trừ khi bạn chọn thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide 会将其替换的每个文件移到同一位置，并命名为类似 CLAUDE.md.coincide-backup-<date> 的备份，绝不会删除文本。指向其他文件的链接不会改动，除非您选择替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide 會將其取代的每個檔案移到同一位置，並命名為類似 CLAUDE.md.coincide-backup-<date> 的備份，且絕不會刪除文字。指向其他檔案的連結不會更動，除非您選擇取代。"
          }
        }
      }
    },
