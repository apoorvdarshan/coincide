    "Running agents and terminal commands in these threads will stop. Undo restores conversations, but does not restart stopped work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laufende Agenten und Terminalbefehle in diesen Threads werden gestoppt. Rückgängig stellt Unterhaltungen wieder her, startet aber keine gestoppte Arbeit neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se detendrán los agentes y comandos de terminal en ejecución en estos hilos. Deshacer restaura las conversaciones, pero no reinicia el trabajo detenido."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
