    "Sign in to Antigravity in Settings before you continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Melde dich in den Einstellungen bei Antigravity an, bevor du fortfährst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicia sesión en Antigravity en Ajustes antes de continuar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicia sesión en Antigravity en Configuración antes de continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connectez-vous à Antigravity dans Réglages avant de continuer."
          }
