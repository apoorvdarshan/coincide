    "⌘N starts a chat without a project, like a chat app. New threads in a project stay in its menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⌘N startet einen Chat ohne Projekt, wie in einer Chat-App. Neue Unterhaltungen in einem Projekt bleiben in dessen Menü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⌘N inicia un chat sin proyecto, como en una app de chat. Los nuevos hilos de un proyecto siguen en su menú."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
