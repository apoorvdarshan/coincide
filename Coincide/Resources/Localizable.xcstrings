        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bot adalah percakapan berkelanjutan dengan kepribadian dan tugasnya sendiri. Bot dijalankan oleh agen Anda seperti utas lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un bot è una conversazione continua con una propria personalità e un proprio compito. Funziona con i tuoi agenti come qualsiasi thread."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ボットは、独自の個性と役割を持つ継続的な会話です。ほかのスレッドと同じようにエージェント上で動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "봇은 고유한 성격과 역할을 가진 지속적인 대화입니다. 다른 스레드처럼 에이전트에서 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Een bot is een doorlopend gesprek met een eigen persoonlijkheid en taak. Hij draait op je agents zoals elke thread."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bot to stała rozmowa z własną osobowością i zadaniem. Działa na Twoich agentach jak każdy wątek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um bot é uma conversa contínua com personalidade e função próprias. Ele roda nos seus agentes como qualquer conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Бот — это постоянная беседа со своим характером и задачей. Он работает на ваших агентах, как любой чат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bot, kendi kişiliği ve görevi olan süregelen bir konuşmadır. Her sohbet gibi ajanlarınız üzerinde çalışır."
