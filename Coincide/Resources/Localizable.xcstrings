    "Antigravity uses your Google account’s subscription. Coincide keeps this sign-in in its own Antigravity profile, separate from ~/.gemini and any other Antigravity install." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antigravity verwendet das Abo deines Google-Accounts. Coincide speichert diese Anmeldung in einem eigenen Antigravity-Profil, getrennt von ~/.gemini und anderen Antigravity-Installationen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Antigravity usa la suscripción de tu cuenta de Google. Coincide guarda este inicio de sesión en su propio perfil de Antigravity, separado de ~/.gemini y de cualquier otra instalación de Antigravity."
          }
        },
        "es-419" : {
          "stringUnit" : {
