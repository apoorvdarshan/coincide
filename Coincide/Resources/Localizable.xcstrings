    "Links CLAUDE.md, GEMINI.md and the other agents' files to one master file. Files that differ are backed up first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verknüpft CLAUDE.md, GEMINI.md und die Dateien der anderen Agenten mit einer Hauptdatei. Abweichende Dateien werden zuvor gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enlaza CLAUDE.md, GEMINI.md y los archivos de los demás agentes con un único archivo principal. Antes se hace una copia de seguridad de los archivos que difieren."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enlaza CLAUDE.md, GEMINI.md y los archivos de los demás agentes con un único archivo principal. Antes se crea un respaldo de los archivos que difieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lie CLAUDE.md, GEMINI.md et les fichiers des autres agents à un seul fichier principal. Les fichiers différents sont d’abord sauvegardés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
