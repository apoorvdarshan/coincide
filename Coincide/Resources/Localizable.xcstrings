    },
    "Messages sent while an agent works go into its current turn, if it can take them. Command-Return queues one for after the turn instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nachrichten, die du sendest, während ein Agent arbeitet, gehen in seinen laufenden Durchgang, sofern er sie annehmen kann. Mit Befehl-Zeilenschalter wird eine stattdessen für nach dem Durchgang eingereiht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes enviados mientras un agente trabaja entran en su turno actual, si puede recibirlos. Comando-Retorno pone uno en cola para después del turno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes que envías mientras un agente trabaja se incorporan a su turno actual, si puede recibirlos. En su lugar, Comando-Retorno pone uno en cola para después del turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les messages envoyés pendant qu'un agent travaille rejoignent son tour en cours, s'il peut les recevoir. Commande-Retour en met un en file d'attente pour après le tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एजेंट के काम करते समय भेजे गए संदेश उसके मौजूदा टर्न में जाते हैं, अगर वह उन्हें ले सके। इसके बजाय Command-Return संदेश को टर्न के बाद के लिए कतार में डालता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pesan yang dikirim saat agen bekerja masuk ke giliran saat ini, jika agen dapat menerimanya. Command-Return memasukkan pesan ke antrean untuk setelah giliran selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I messaggi inviati mentre un agente lavora entrano nel turno corrente, se può riceverli. Comando-Invio invece ne mette uno in coda per dopo il turno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントの作業中に送信したメッセージは、受け付け可能であれば現在のターンに送られます。Command + Returnキーを押すと、代わりにターンの終了後に送信するようキューに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트가 작업하는 동안 보낸 메시지는 받을 수 있는 경우 현재 턴에 들어갑니다. Command-Return을 누르면 대신 턴이 끝난 후 보내도록 대기열에 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berichten die je stuurt terwijl een agent werkt, gaan naar de huidige beurt als de agent ze kan aannemen. Met Command-Return zet je er in plaats daarvan een in de wachtrij voor na de beurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wiadomości wysłane podczas pracy agenta trafiają do jego bieżącej tury, jeśli może je przyjąć. Command-Return zamiast tego dodaje wiadomość do kolejki na czas po zakończeniu tury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As mensagens enviadas enquanto um agente trabalha entram no turno atual, se ele puder recebê-las. Command-Return põe uma na fila para depois do turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сообщения, отправленные во время работы агента, попадают в текущий ход, если агент может их принять. Command-Return вместо этого ставит сообщение в очередь до конца хода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajan çalışırken gönderilen mesajlar, alabiliyorsa geçerli turuna eklenir. Command-Return ise mesajı tur bitince gönderilmek üzere sıraya alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Повідомлення, надіслані під час роботи агента, потрапляють у поточний хід, якщо агент може їх прийняти. Command-Return натомість ставить повідомлення в чергу до завершення ходу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tin nhắn gửi khi agent đang làm việc sẽ đi vào lượt hiện tại của agent, nếu agent có thể nhận. Command-Return sẽ đưa tin nhắn vào hàng đợi cho sau lượt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "智能体工作时发送的消息会进入其当前轮次（如果它能接收）。按 Command-Return 则会将消息排队，待本轮结束后发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "代理程式工作期間傳送的訊息，若代理程式可以接收，會送入目前的回合。按 Command-Return 則會將訊息排入佇列，待回合結束後傳送。"
          }
        }
      }
    },
    "Messages sent while an agent works go into its current turn, if it can take them. Shift-Command-Return queues one for after the turn instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nachrichten, die du sendest, während ein Agent arbeitet, gehen in seinen laufenden Durchgang, sofern er sie annehmen kann. Mit Umschalt-Befehl-Zeilenschalter wird eine stattdessen für nach dem Durchgang eingereiht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes enviados mientras un agente trabaja entran en su turno actual, si puede recibirlos. Mayúsculas-Comando-Retorno pone uno en cola para después del turno."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los mensajes que envías mientras un agente trabaja se incorporan a su turno actual, si puede recibirlos. En su lugar, Mayúsculas-Comando-Retorno pone uno en cola para después del turno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les messages envoyés pendant qu'un agent travaille rejoignent son tour en cours, s'il peut les recevoir. Maj-Commande-Retour en met un en file d'attente pour après le tour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एजेंट के काम करते समय भेजे गए संदेश उसके मौजूदा टर्न में जाते हैं, अगर वह उन्हें ले सके। इसके बजाय Shift-Command-Return संदेश को टर्न के बाद के लिए कतार में डालता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pesan yang dikirim saat agen bekerja masuk ke giliran saat ini, jika agen dapat menerimanya. Shift-Command-Return memasukkan pesan ke antrean untuk setelah giliran selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I messaggi inviati mentre un agente lavora entrano nel turno corrente, se può riceverli. Maiuscole-Comando-Invio invece ne mette uno in coda per dopo il turno."
          }
        },
        "ja" : {
          "stringUnit" : {
