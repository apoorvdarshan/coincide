    "Keep Awake comes from macbook-24x7-agents, which keeps a MacBook running agents with the lid closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Wach halten“ stammt von macbook-24x7-agents, das ein MacBook bei geschlossenem Deckel Agenten ausführen lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantener activo proviene de macbook-24x7-agents, que mantiene un MacBook ejecutando agentes con la tapa cerrada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantener activo proviene de macbook-24x7-agents, que mantiene un MacBook ejecutando agentes con la tapa cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garder éveillé vient de macbook-24x7-agents, qui permet à un MacBook d’exécuter des agents écran rabattu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जागृत रखें macbook-24x7-agents से आया है, जो ढक्कन बंद होने पर भी MacBook पर एजेंट चलाता रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tetap Terjaga berasal dari macbook-24x7-agents, yang membuat MacBook menjalankan agen dengan penutup tertutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantieni attivo deriva da macbook-24x7-agents, che fa eseguire agenti a un MacBook con il coperchio chiuso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「スリープさせない」は、蓋を閉じたMacBookでエージェントを動かし続けるmacbook-24x7-agentsに基づいています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "깨어 있기는 덮개를 닫은 MacBook에서 에이전트를 계속 실행하는 macbook-24x7-agents에서 왔습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wakker houden komt van macbook-24x7-agents, waarmee een MacBook agents draait met de klep dicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie usypiaj pochodzi z macbook-24x7-agents, który pozwala MacBookowi uruchamiać agentów przy zamkniętej pokrywie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manter Ativo vem do macbook-24x7-agents, que mantém um MacBook rodando agentes com a tampa fechada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Не спать» взято из macbook-24x7-agents, который позволяет MacBook запускать агентов с закрытой крышкой."
