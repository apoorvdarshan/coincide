    "Snapshot the working tree before each turn so you can review or revert what it changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vor jedem Durchgang einen Snapshot des Arbeitsverzeichnisses erstellen, damit du seine Änderungen prüfen oder zurücksetzen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hacer una instantánea del árbol de trabajo antes de cada turno para poder revisar o revertir lo que haya cambiado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tomar una instantánea del árbol de trabajo antes de cada turno para que puedas revisar o revertir lo que cambió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prendre un instantané de l'arbre de travail avant chaque tour pour pouvoir vérifier ou annuler ses modifications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर टर्न से पहले वर्किंग ट्री का स्नैपशॉट लें, ताकि आप उसके बदलावों की समीक्षा कर सकें या उन्हें रिवर्ट कर सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buat snapshot working tree sebelum setiap giliran agar Anda dapat meninjau atau mengembalikan perubahannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crea un'istantanea del working tree prima di ogni turno per poter controllare o ripristinare ciò che ha modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各ターンの前に作業ツリーのスナップショットを作成し、変更内容を確認したり元に戻したりできるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 턴 전에 작업 트리의 스냅샷을 만들어 턴에서 변경한 내용을 검토하거나 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maak vóór elke beurt een snapshot van de working tree, zodat je kunt bekijken of terugzetten wat die beurt heeft gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zapisuj stan drzewa roboczego przed każdą turą, aby móc przejrzeć lub cofnąć wprowadzone w niej zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cria um snapshot da árvore de trabalho antes de cada turno para que você possa revisar ou reverter o que ele alterou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сохранять снимок рабочего дерева перед каждым ходом, чтобы можно было просмотреть или откатить его изменения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Turun değiştirdiklerini gözden geçirebilmek veya geri döndürebilmek için her turdan önce çalışma ağacının anlık görüntüsünü al."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Робити знімок робочої копії перед кожним ходом, щоб можна було переглянути або відкотити його зміни."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chụp nhanh working tree trước mỗi lượt để bạn có thể xem lại hoặc hoàn nguyên những gì lượt đó đã thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在每轮开始前为工作区创建快照，以便你检查或还原该轮所做的更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在每個回合開始前建立工作目錄的快照，讓你可以檢視或回復其所做的變更。"
          }
        }
      }
    },
