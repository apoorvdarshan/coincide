    "Git's index is locked. Wait for other Git operations to finish, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Git-Index ist gesperrt. Warte, bis andere Git-Vorgänge abgeschlossen sind, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El índice de Git está bloqueado. Espera a que terminen otras operaciones de Git y vuelve a intentarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El índice de Git está bloqueado. Espera a que terminen otras operaciones de Git e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'index de Git est verrouillé. Attendez la fin des autres opérations Git, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Git का इंडेक्स लॉक है। दूसरी Git कार्रवाइयों के पूरा होने का इंतज़ार करें, फिर दोबारा कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indeks Git terkunci. Tunggu hingga operasi Git lainnya selesai, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'indice di Git è bloccato. Attendi il termine delle altre operazioni Git, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gitのインデックスがロックされています。ほかのGit操作が終わるのを待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Git 인덱스가 잠겨 있습니다. 다른 Git 작업이 끝날 때까지 기다린 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De Git-index is vergrendeld. Wacht tot andere Git-bewerkingen klaar zijn en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indeks Git jest zablokowany. Poczekaj na zakończenie innych operacji Git i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O índice do Git está bloqueado. Aguarde as outras operações do Git terminarem e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Индекс Git заблокирован. Дождитесь завершения других операций Git и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Git dizini kilitli. Diğer Git işlemlerinin bitmesini bekleyin, sonra yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Індекс Git заблоковано. Зачекайте, поки завершаться інші операції Git, і спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Index của Git đang bị khóa. Hãy chờ các thao tác Git khác hoàn tất, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Git 索引已锁定。请等待其他 Git 操作完成，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Git 的索引已鎖定。請等待其他 Git 操作完成，然後再試一次。"
          }
        }
      }
