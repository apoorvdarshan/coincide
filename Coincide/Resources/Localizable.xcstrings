    "Good day. How can I help you?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guten Tag. Wie kann ich Ihnen helfen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buenos días. ¿En qué puedo ayudarle?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buen día. ¿En qué puedo ayudarle?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bonjour. Que puis-je faire pour vous ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नमस्कार। बताइए, आपकी क्या सहायता की जाए?"
