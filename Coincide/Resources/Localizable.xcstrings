          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GitHub の機能リクエストフォームに記入するか、Discord の機能リクエストチャンネルで /feature を使ってください。チャンネルリンクはサーバーに参加すると使えます。Discord で送ったリクエストは公開の GitHub Issue になり、GitHub アカウントは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GitHub에서 기능 요청 양식을 작성하거나 Discord의 기능 요청 채널에서 /feature를 사용하세요. 채널 링크는 서버에 참여한 후에 작동합니다. Discord에서 보낸 요청은 공개 GitHub 이슈가 되며 GitHub 계정이 필요하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vul het formulier voor functieverzoeken op GitHub in, of gebruik /feature in het kanaal voor functieverzoeken op Discord. Kanaallinks werken zodra je lid bent van de server. Verzoeken via Discord worden openbare GitHub-issues en vereisen geen GitHub-account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wypełnij formularz propozycji funkcji na GitHubie albo użyj /feature na kanale propozycji funkcji na Discordzie. Linki do kanałów działają po dołączeniu do serwera. Propozycje wysłane na Discordzie stają się publicznymi zgłoszeniami na GitHubie i nie wymagają konta GitHub."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Preencha o formulário de solicitação de recurso no GitHub ou use /feature no canal de solicitações de recursos do Discord. Os links de canais funcionam depois que você entra no servidor. Solicitações enviadas no Discord viram issues públicas no GitHub e não exigem conta no GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заполните форму предложения функции на GitHub или используйте /feature в канале предложений функций в Discord. Ссылки на каналы работают после вступления на сервер. Предложения, отправленные в Discord, становятся публичными задачами на GitHub и не требуют аккаунта GitHub."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "GitHub'da özellik isteği formunu doldurun veya Discord'daki özellik istekleri kanalında /feature komutunu kullanın. Kanal bağlantıları sunucuya katıldıktan sonra çalışır. Discord'da gönderilen istekler herkese açık GitHub sorun kayıtlarına dönüşür ve GitHub hesabı gerektirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Заповніть форму пропозиції функції на GitHub або скористайтеся /feature у каналі пропозицій функцій у Discord. Посилання на канали працюють, щойно ви приєднаєтеся до сервера. Пропозиції, надіслані в Discord, стають публічними задачами на GitHub і не потребують облікового запису GitHub."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Điền biểu mẫu yêu cầu tính năng trên GitHub, hoặc dùng /feature trong kênh yêu cầu tính năng trên Discord. Liên kết kênh hoạt động sau khi bạn tham gia máy chủ. Yêu cầu gửi trên Discord sẽ trở thành issue công khai trên GitHub và không cần tài khoản GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 GitHub 上填写功能请求表单，或在 Discord 的功能请求频道使用 /feature。加入服务器后频道链接才能使用。在 Discord 上提交的请求会成为公开的 GitHub 议题，无需 GitHub 账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 GitHub 上填寫功能請求表單，或在 Discord 的功能請求頻道使用 /feature。加入伺服器後頻道連結才能使用。在 Discord 上送出的請求會成為公開的 GitHub 議題，不需要 GitHub 帳號。"
          }
        }
      }
    },
