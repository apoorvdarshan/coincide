        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Merhaba. Neye ihtiyacınız var?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вітаю. Що потрібно?"
          }
