    "What an agent schedules in its thread waits for you to allow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was ein Agent in seinem Thread plant, wartet auf deine Erlaubnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que un agente programe en su conversación espera a que lo permitas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que un agente programe en su conversación espera a que lo permitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce qu’un agent planifie dans sa discussion attend votre autorisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एजेंट अपने थ्रेड में जो भी निर्धारित करता है, वह आपकी अनुमति का इंतज़ार करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apa yang dijadwalkan agen di utasnya menunggu izin Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciò che un agente pianifica nel suo thread attende il tuo consenso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "エージェントが自分のスレッドでスケジュールしたものは、あなたが許可するまで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "에이전트가 자신의 스레드에서 예약한 항목은 사용자가 허용할 때까지 대기합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wat een agent in zijn thread inplant, wacht tot je het toestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To, co agent zaplanuje w swoim wątku, czeka na Twoją zgodę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O que um agente agenda na própria conversa aguarda a sua permissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "То, что агент планирует в своём чате, ждёт вашего разрешения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bir ajanın kendi sohbetinde zamanladıkları, izin vermenizi bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Те, що агент планує у своєму чаті, чекає вашого дозволу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Những gì agent lên lịch trong luồng của mình sẽ chờ bạn cho phép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "智能体在其对话中安排的计划会等待你允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "代理程式在其對話中安排的排程會等待你允許。"
          }
        }
      }
    },
