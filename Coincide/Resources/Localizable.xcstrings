          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide se connecte à chaque gestionnaire de mots de passe via son outil en ligne de commande : vous n’avez donc pas besoin de son extension de navigateur. Dans le navigateur, Coincide saisit lui-même les mots de passe et les codes à usage unique dans la page, après votre autorisation pour le site."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide हर पासवर्ड मैनेजर से उसके कमांड-लाइन टूल के ज़रिए जुड़ता है, इसलिए आपको उसके ब्राउज़र एक्सटेंशन की ज़रूरत नहीं है। ब्राउज़र में, साइट के लिए आपकी अनुमति के बाद Coincide पासवर्ड और वन-टाइम कोड खुद पेज में टाइप करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide terhubung ke setiap pengelola kata sandi melalui alat baris perintahnya, jadi Anda tidak memerlukan ekstensi browsernya. Di browser, Coincide sendiri yang mengetik kata sandi dan kode sekali pakai ke halaman setelah Anda mengizinkannya untuk situs itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide si collega a ogni gestore di password tramite il suo strumento da riga di comando, quindi non ti serve la sua estensione per il browser. Nel browser è Coincide a digitare password e codici monouso nella pagina, dopo che l’hai consentito per il sito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
