    "You can undo this deletion until Coincide quits or the undo history is cleared. Files in your project are not changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst diese Löschung rückgängig machen, bis Coincide beendet oder der Rückgängig-Verlauf geleert wird. Dateien in deinem Projekt werden nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes deshacer esta eliminación hasta que se cierre Coincide o se borre el historial de deshacer. Los archivos de tu proyecto no cambian."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes deshacer esta eliminación hasta que se cierre Coincide o se borre el historial de deshacer. Los archivos de tu proyecto no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous pouvez annuler cette suppression jusqu’à la fermeture de Coincide ou l’effacement de l’historique d’annulation. Les fichiers de votre projet ne sont pas modifiés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide बंद होने या पूर्ववत इतिहास साफ़ होने तक आप यह हटाना पूर्ववत कर सकते हैं। आपके प्रोजेक्ट की फ़ाइलें नहीं बदलतीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anda dapat membatalkan penghapusan ini sampai Coincide ditutup atau riwayat pembatalan dihapus. File dalam proyek Anda tidak diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puoi annullare questa eliminazione finché Coincide non viene chiuso o la cronologia degli annullamenti non viene cancellata. I file del progetto non vengono modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide を終了するか、取り消し履歴が消去されるまで、この削除を取り消せます。プロジェクトのファイルは変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide를 종료하거나 실행 취소 기록을 지울 때까지 이 삭제를 취소할 수 있습니다. 프로젝트 파일은 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je kunt deze verwijdering ongedaan maken totdat Coincide wordt afgesloten of de geschiedenis voor ongedaan maken wordt gewist. Bestanden in je project worden niet gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Możesz cofnąć to usunięcie do zamknięcia Coincide lub wyczyszczenia historii cofania. Pliki projektu nie zostaną zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Você pode desfazer esta exclusão até fechar o Coincide ou limpar o histórico de desfazer. Os arquivos do projeto não são alterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удаление можно отменить до закрытия Coincide или очистки истории отмены. Файлы проекта не изменяются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide kapanana veya geri alma geçmişi temizlenene kadar bu silme işlemini geri alabilirsiniz. Projenizdeki dosyalar değiştirilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Видалення можна скасувати до закриття Coincide або очищення історії скасувань. Файли проєкту не змінюються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bạn có thể hoàn tác việc xóa này cho đến khi thoát Coincide hoặc xóa lịch sử hoàn tác. Các tệp trong dự án không bị thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在退出 Coincide 或清除撤销历史记录之前，你可以撤销此次删除。项目中的文件不会更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在結束 Coincide 或清除還原記錄之前，你可以還原此次刪除。專案中的檔案不會變更。"
          }
        }
      }
    },
