    "Agents ask you to take over for sign-ins, CAPTCHAs and two-factor codes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für Anmeldungen, CAPTCHAs und Bestätigungscodes bitten Agenten dich, zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
