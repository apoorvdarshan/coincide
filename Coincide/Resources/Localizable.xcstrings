          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Historia wątków zostanie zachowana. Antigravity poprosi o ponowne zalogowanie przed następną turą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O histórico da conversa é mantido. O Antigravity pede que você faça login novamente antes do próximo turno."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
