    "Hold the shortcut to talk and let go to stop, or tap it to start and tap again to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte das Tastenkürzel zum Sprechen gedrückt und lass es zum Beenden los, oder tippe es zum Starten an und tippe zum Beenden erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsada la función rápida para hablar y suéltala para detener, o púlsala para empezar y vuelve a pulsarla para detener."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén presionado el atajo para hablar y suéltalo para detener, o presiónalo para empezar y vuelve a presionarlo para detener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez le raccourci pour parler et relâchez-le pour arrêter, ou appuyez dessus pour commencer et appuyez à nouveau pour arrêter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बोलने के लिए शॉर्टकट दबाए रखें और रोकने के लिए छोड़ दें, या शुरू करने के लिए इसे टैप करें और रोकने के लिए फिर से टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tahan pintasan untuk berbicara dan lepaskan untuk berhenti, atau ketuk untuk memulai dan ketuk lagi untuk berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuta l’abbreviazione per parlare e rilasciala per fermarti, oppure premila per iniziare e premila di nuovo per fermarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ショートカットを押している間に話し、離すと停止します。または、押して開始し、もう一度押すと停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "단축키를 누르고 있는 동안 말하고 떼면 중단하거나, 짧게 눌러 시작하고 다시 짧게 눌러 중단하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd de toetscombinatie ingedrukt om te praten en laat los om te stoppen, of druk er kort op om te beginnen en nogmaals om te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przytrzymaj skrót, aby mówić, i puść, aby zakończyć, albo naciśnij go, aby zacząć, i naciśnij ponownie, aby zakończyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Segure o atalho para falar e solte para parar, ou pressione-o para começar e pressione de novo para parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удерживайте сочетание клавиш, пока говорите, и отпустите, чтобы остановить, или нажмите его для начала и ещё раз для остановки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konuşmak için kestirmeyi basılı tutun, durdurmak için bırakın ya da başlatmak için bir kez, durdurmak için yeniden basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Утримуйте скорочення, поки говорите, і відпустіть, щоб зупинити, або натисніть його для початку і ще раз для зупинки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giữ phím tắt để nói và thả ra để dừng, hoặc nhấn một lần để bắt đầu và nhấn lại để dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住快捷键说话，松开即停止；或轻按一次开始，再轻按一次停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住快速鍵說話，放開即停止；或點一下開始，再點一下停止。"
          }
        }
      }
    },
