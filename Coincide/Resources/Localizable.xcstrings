          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Porta cookie e accessi, cronologia e segnalibri da Safari, Chrome, Firefox e altri. Nulla lascia questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari、Chrome、Firefox などから Cookie とサインイン、履歴、ブックマークを読み込みます。データはこの Mac の外に出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari, Chrome, Firefox 등에서 쿠키와 로그인, 방문 기록, 북마크를 가져옵니다. 이 Mac 밖으로 나가는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haal cookies en aanmeldingen, geschiedenis en bladwijzers op uit Safari, Chrome, Firefox en andere. Niets verlaat deze Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przenieś pliki cookie i logowania, historię oraz zakładki z Safari, Chrome, Firefoxa i innych. Nic nie opuszcza tego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Traga cookies e logins, histórico e favoritos do Safari, Chrome, Firefox e outros. Nada sai deste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перенесите cookie и входы, историю и закладки из Safari, Chrome, Firefox и других. Ничего не покидает этот Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Safari, Chrome, Firefox ve diğerlerinden çerezleri ve oturumları, geçmişi ve yer imlerini getirin. Hiçbir şey bu Mac’ten çıkmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перенесіть cookie та входи, історію й закладки з Safari, Chrome, Firefox та інших. Ніщо не залишає цей Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Đưa cookie và trạng thái đăng nhập, lịch sử, dấu trang từ Safari, Chrome, Firefox và các trình duyệt khác. Không có gì rời khỏi máy Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "从 Safari、Chrome、Firefox 等导入 Cookie 和登录状态、历史记录及书签。任何数据都不会离开这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "從 Safari、Chrome、Firefox 等匯入 Cookie 和登入狀態、瀏覽記錄及書籤。任何資料都不會離開這台 Mac。"
          }
        }
      }
    },
