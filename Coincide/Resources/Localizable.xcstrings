          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez Coincide Remote sur votre iPhone ou iPad, touchez « Scanner le code de jumelage » et pointez l'appareil photo ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने iPhone या iPad पर Coincide Remote खोलें, “पेयरिंग कोड स्कैन करें” पर टैप करें और कैमरा यहाँ रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buka Coincide Remote di iPhone atau iPad Anda, ketuk Pindai Kode Pemasangan, lalu arahkan kamera ke sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apri Coincide Remote su iPhone o iPad, tocca “Scansiona codice di abbinamento” e inquadra questo codice con la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhoneまたはiPadでCoincide Remoteを開き、“ペアリングコードをスキャン”をタップして、カメラをここに向けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone 또는 iPad에서 Coincide Remote를 열고 “페어링 코드 스캔”을 탭한 다음 카메라를 여기에 향하게 하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Open Coincide Remote op je iPhone of iPad, tik op “Scan koppelcode” en richt de camera hierop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otwórz Coincide Remote na iPhonie lub iPadzie, stuknij „Skanuj kod parowania” i skieruj aparat tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abra o Coincide Remote no seu iPhone ou iPad, toque em “Escanear Código de Emparelhamento” e aponte a câmera para cá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Откройте Coincide Remote на iPhone или iPad, нажмите «Сканировать код привязки» и наведите камеру сюда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iPhone veya iPad'inizde Coincide Remote'u açın, Eşleştirme Kodunu Tara'ya dokunun ve kamerayı buraya tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Відкрийте Coincide Remote на iPhone або iPad, торкніться «Сканувати код прив’язки» й наведіть камеру сюди."
          }
        },
        "vi" : {
          "stringUnit" : {
