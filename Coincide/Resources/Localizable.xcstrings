    "Turning sync off copies the master back to this Mac and links the agents to the copy. The repository stays as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Deaktivieren der Synchronisierung wird die Hauptdatei zurück auf diesen Mac kopiert und die Agenten werden mit der Kopie verknüpft. Das Repository bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al desactivar la sincronización, el archivo principal se copia de nuevo en este Mac y los agentes se enlazan con la copia. El repositorio se queda como está."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al desactivar la sincronización, el archivo principal se copia de vuelta en esta Mac y los agentes se enlazan con la copia. El repositorio se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La désactivation de la synchronisation recopie le fichier principal sur ce Mac et lie les agents à la copie. Le dépôt reste tel quel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सिंक बंद करने पर मास्टर फ़ाइल वापस इस Mac पर कॉपी हो जाती है और एजेंट उस कॉपी से लिंक हो जाते हैं। रिपॉज़िटरी जैसी है वैसी रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mematikan sinkronisasi menyalin berkas utama kembali ke Mac ini dan menautkan agen ke salinan tersebut. Repositori tetap apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Disattivando la sincronizzazione, il file principale viene copiato di nuovo su questo Mac e gli agenti vengono collegati alla copia. Il repository resta invariato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同期をオフにすると、マスターファイルがこの Mac にコピーし直され、エージェントはそのコピーにリンクされます。リポジトリはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "동기화를 끄면 마스터 파일이 이 Mac으로 다시 복사되고 에이전트가 그 사본에 링크됩니다. 저장소는 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je synchronisatie uitschakelt, wordt het hoofdbestand teruggekopieerd naar deze Mac en worden de agents aan de kopie gekoppeld. De repository blijft zoals hij is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wyłączenie synchronizacji kopiuje plik główny z powrotem na ten Mac i dowiązuje agentów do kopii. Repozytorium pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ao desativar a sincronização, o arquivo principal é copiado de volta para este Mac e os agentes são vinculados à cópia. O repositório permanece como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "При выключении синхронизации основной файл копируется обратно на этот Mac, а агенты связываются с копией. Репозиторий остаётся как есть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eşitlemeyi kapatmak ana dosyayı bu Mac'e geri kopyalar ve ajanları kopyaya bağlar. Depo olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вимкнення синхронізації копіює основний файл назад на цей Mac і пов’язує агентів із копією. Репозиторій залишається без змін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tắt đồng bộ sẽ sao chép tệp chính trở lại máy Mac này và liên kết các tác nhân tới bản sao đó. Kho lưu trữ giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "关闭同步会将主文件复制回这台 Mac，并将各智能体链接到该副本。仓库保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "關閉同步會將主檔案拷貝回這部 Mac，並將代理程式連結到該副本。儲存庫會維持原樣。"
          }
        }
      }
    },
