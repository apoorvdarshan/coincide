    "Cookies and site data include sign-ins in the shared browser profile; pages open in threads reload. Bookmarks are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cookies und Website-Daten umfassen die Anmeldungen im gemeinsamen Browserprofil; geöffnete Seiten in Threads werden neu geladen. Lesezeichen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las cookies y los datos de sitios incluyen los inicios de sesión del perfil compartido; las páginas abiertas en los hilos se recargan. Los marcadores se conservan."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
