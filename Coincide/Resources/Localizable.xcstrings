    "Providers list their models once they’re installed and signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anbieter listen ihre Modelle auf, sobald sie installiert und angemeldet sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los proveedores muestran sus modelos cuando están instalados y con la sesión iniciada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los proveedores muestran sus modelos una vez que están instalados y con la sesión iniciada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fournisseurs affichent leurs modèles une fois installés et connectés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इंस्टॉल और साइन इन होने के बाद प्रोवाइडर अपने मॉडल दिखाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penyedia mencantumkan modelnya setelah terinstal dan masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I provider elencano i loro modelli dopo l'installazione e l'accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プロバイダは、インストールしてサインインするとモデルを一覧表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "제공자를 설치하고 로그인하면 모델 목록이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aanbieders tonen hun modellen zodra ze zijn geïnstalleerd en je bent ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dostawcy wyświetlają swoje modele po zainstalowaniu i zalogowaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os provedores listam seus modelos depois de instalados e com o login feito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Провайдеры показывают свои модели после установки и входа."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sağlayıcılar, yüklenip giriş yapıldıktan sonra modellerini listeler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Провайдери показують свої моделі, щойно їх установлено й виконано вхід."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nhà cung cấp sẽ liệt kê mô hình sau khi được cài đặt và đăng nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "提供商在安装并登录后会列出其模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "供應商安裝並登入後，會列出其模型。"
          }
        }
      }
    },
    "Providers, custom models and the default model for new threads are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anbieter, eigene Modelle und das Standardmodell für neue Threads bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conservan los proveedores, los modelos personalizados y el modelo predeterminado para conversaciones nuevas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conservan los proveedores, los modelos personalizados y el modelo predeterminado para conversaciones nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fournisseurs, les modèles personnalisés et le modèle par défaut des nouvelles discussions sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रोवाइडर, कस्टम मॉडल और नए थ्रेड का डिफ़ॉल्ट मॉडल बने रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penyedia, model khusus, dan model default untuk utas baru tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Provider, modelli personalizzati e modello predefinito per i nuovi thread vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "プロバイダ、カスタムモデル、新規スレッドのデフォルトモデルは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "제공자, 사용자 설정 모델 및 새 스레드의 기본 모델은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
