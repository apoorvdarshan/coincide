    "%@ encrypts cookies with a key in your Keychain. macOS will ask whether Coincide may use “%@”; choose Allow to import cookies. The key is used once, on this Mac, and isn’t kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ verschlüsselt Cookies mit einem Schlüssel in deinem Schlüsselbund. macOS fragt, ob Coincide „%2$@“ verwenden darf; wähle „Erlauben“, um Cookies zu importieren. Der Schlüssel wird einmal auf diesem Mac verwendet und nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ encrypts cookies with a key in your Keychain. macOS will ask whether Coincide may use “%2$@”; choose Allow to import cookies. The key is used once, on this Mac, and isn’t kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ cifra las cookies con una clave de tu llavero. macOS preguntará si Coincide puede usar “%2$@”; elige Permitir para importar las cookies. La clave se usa una vez, en este Mac, y no se guarda."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ cifra las cookies con una clave de tu llavero. macOS preguntará si Coincide puede usar “%2$@”; elige Permitir para importar las cookies. La clave se usa una vez, en este Mac, y no se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ chiffre les cookies avec une clé de votre trousseau. macOS vous demandera si Coincide peut utiliser « %2$@ » ; choisissez Autoriser pour importer les cookies. La clé est utilisée une fois, sur ce Mac, et n’est pas conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ आपके कीचेन की एक कुंजी से कुकीज़ एन्क्रिप्ट करता है। macOS पूछेगा कि क्या Coincide “%2$@” का उपयोग कर सकता है; कुकीज़ इम्पोर्ट करने के लिए अनुमति दें चुनें। कुंजी इसी Mac पर एक बार उपयोग होती है और रखी नहीं जाती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ mengenkripsi cookie dengan kunci di Rantai Kunci Anda. macOS akan menanyakan apakah Coincide boleh memakai “%2$@”; pilih Izinkan untuk mengimpor cookie. Kunci dipakai sekali, di Mac ini, dan tidak disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ cifra i cookie con una chiave nel tuo portachiavi. macOS chiederà se Coincide può usare “%2$@”; scegli Consenti per importare i cookie. La chiave viene usata una volta, su questo Mac, e non viene conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ はキーチェーン内の鍵で Cookie を暗号化しています。macOS が Coincide に「%2$@」の使用を許可するか確認するので、Cookie を読み込むには「許可」を選んでください。鍵はこの Mac で一度だけ使われ、保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@은(는) 키체인의 키로 쿠키를 암호화합니다. macOS가 Coincide의 ‘%2$@’ 사용 허용 여부를 물으면 쿠키를 가져오려면 허용을 선택하세요. 키는 이 Mac에서 한 번만 사용되며 보관되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ versleutelt cookies met een sleutel in je sleutelhanger. macOS vraagt of Coincide ‘%2$@’ mag gebruiken; kies Sta toe om cookies te importeren. De sleutel wordt één keer op deze Mac gebruikt en niet bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ szyfruje pliki cookie kluczem z pęku kluczy. macOS zapyta, czy Coincide może użyć „%2$@”; wybierz Pozwól, aby zaimportować pliki cookie. Klucz jest używany raz, na tym Macu, i nie jest przechowywany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ criptografa os cookies com uma chave nas suas Chaves. O macOS vai perguntar se o Coincide pode usar “%2$@”; escolha Permitir para importar os cookies. A chave é usada uma vez, neste Mac, e não é guardada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ шифрует cookie ключом из вашей связки ключей. macOS спросит, можно ли Coincide использовать «%2$@»; выберите «Разрешить», чтобы импортировать cookie. Ключ используется один раз на этом Mac и не сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@, çerezleri Anahtar Zinciri’nizdeki bir anahtarla şifreler. macOS, Coincide’ın “%2$@” öğesini kullanıp kullanamayacağını soracak; çerezleri içe aktarmak için İzin Ver’i seçin. Anahtar bu Mac’te bir kez kullanılır ve saklanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ шифрує cookie ключем із вашої в’язки ключів. macOS запитає, чи може Coincide використати «%2$@»; виберіть «Дозволити», щоб імпортувати cookie. Ключ використовується один раз на цьому Mac і не зберігається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ mã hóa cookie bằng một khóa trong Chuỗi khóa của bạn. macOS sẽ hỏi liệu Coincide có được dùng “%2$@” không; chọn Cho phép để nhập cookie. Khóa chỉ được dùng một lần trên máy Mac này và không được lưu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ 使用钥匙串中的密钥加密 Cookie。macOS 会询问是否允许 Coincide 使用“%2$@”；选择“允许”即可导入 Cookie。该密钥只在这台 Mac 上使用一次，不会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ 使用鑰匙圈中的密鑰加密 Cookie。macOS 會詢問是否允許 Coincide 使用「%2$@」；選擇「允許」即可匯入 Cookie。該密鑰只在這台 Mac 上使用一次，不會被保留。"
          }
        }
      }
    },
