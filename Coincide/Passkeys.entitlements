<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opt-in (see Signing.xcconfig): lets the browser panel use passkeys and security keys on any site, through the
	     system's passkey sheet. A managed entitlement Apple grants to browsers; it needs a provisioning profile that
	     includes it, so ad-hoc builds and builds without that profile leave it out. -->
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
