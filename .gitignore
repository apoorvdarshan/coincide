# Generated by XcodeGen from project.yml
/Coincide.xcodeproj/
# CoincideRemote.xcodeproj is committed (store/README.md); Xcode adds this folder when it resolves its packages.
/CoincideRemote.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# Xcode / build output
build/
DerivedData/
.build/
.swiftpm/
*.xcuserstate
xcuserdata/
*.xcresult

# macOS
.DS_Store

# Local agent worktrees
.claude/worktrees/

# Local code signing identity (see Signing.xcconfig)
/Local.xcconfig

# Cua Driver for Computer Use, fetched by scripts/fetch-cua-driver.sh
/Vendor/

# CFBundleVersion, written by scripts/build-number.sh when the project is generated
/BuildNumber.xcconfig

# Coincide Remote with its tests, generated by XcodeGen from project-remote-tests.yml
/CoincideRemoteTests.xcodeproj/

# Wrangler's local cache (website/)
.wrangler/

# Python bytecode from scripts
__pycache__/
*.pyc
